# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/

# Triton JIT cache
~/.triton/

# Proton / profiling artifacts
*.hatchet
*.json.gz

# Benchmark results are scoped by hardware: results/<hardware>/... Only the
# summary CSVs under results/<hardware>/csv/ are version controlled, for any
# hardware label. Raw logs, figures, aggregates (CSV files too) and run
# directories are regenerated by scripts/run_bench.py, scripts/visualize.py,
# scripts/aggregate_results.py and scripts/run_bench_all.py.
results/*
!results/*/
results/*/*
!results/*/csv/
results/*/csv/**
!results/*/csv/**/
!results/*/csv/**/*.csv

# Plots
# *.png
# *.pdf
# *.svg

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Other
meetings/

# LLM-generated experiment artifacts.
# Generation/evaluation infrastructure is version-controlled, while generated
# trajectories and kernels are archived separately.
tilebench/benchmarks/llm_generated/

# Generated artifacts: NCU reports, profiling logs and the detailed
# measure_peak.py sweep. The concise device specs live in
# tilebench/data/peak_performance/ and stay tracked.
outputs/

# Neuron compiler debug dumps / profiler traces (written next to the CWD by
# NEURON_FRAMEWORK_DEBUG=1; the NKI profiling flow keeps them under
# results/<gpu>/logs/nki_profiles/, which is already ignored)
*.neff
*.hlo_module.pb
*.ntff
PostSPMDPassesExecutionDuration.txt
