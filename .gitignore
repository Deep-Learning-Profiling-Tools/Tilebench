# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
.venv/
venv/
env/

# Triton JIT cache
~/.triton/

# Proton / profiling artifacts
*.hatchet
*.json.gz
# Exception: the small per-launch Proton profiles archived with each evaluated
# candidate of a published LLM v2 campaign are evidence indexed by INDEX.json
# (docs/llm_v2/ARTIFACT_POLICY.md); only that path is re-included, not
# profiler output anywhere else.
!artifacts/llm_v2/*/base/**/evaluation/*.hatchet
!artifacts/llm_v2/*/base/**/eval_*/evaluation/*.hatchet
!artifacts/llm_v2/*/enhanced/**/evaluation/*.hatchet
!artifacts/llm_v2/*/enhanced/**/eval_*/evaluation/*.hatchet

# TileLang autotuner runtime log, written to the working directory by the
# autotuner. Not source: the benchmark runners copy each run's part of it to
# results/<hardware>/logs/tilelang_autotuner/, which is archived with the logs.
autotuner.log

# Benchmark results are scoped by hardware: results/<hardware>/... Only the
# summary CSVs under results/<hardware>/csv/ are version controlled, for any
# hardware label. Raw logs, figures, aggregates (CSV files too) and run
# directories are regenerated by scripts/run_bench.py, scripts/visualize.py,
# scripts/aggregate_results.py and scripts/run_bench_all.py.
results/*
!results/*/
results/*/*
!results/*/csv/
results/*/csv/**
!results/*/csv/**/
!results/*/csv/**/*.csv

# Plots
# *.png
# *.pdf
# *.svg

# Jupyter
.ipynb_checkpoints/
*.ipynb

# Editor
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Other
meetings/

# LLM-generated experiment artifacts.
# Generation/evaluation infrastructure is version-controlled, while generated
# trajectories and kernels are archived separately.
tilebench/benchmarks/llm_generated/

# Generated artifacts: NCU reports, profiling logs and the detailed
# measure_peak.py sweep. The concise device specs live in
# tilebench/data/peak_performance/ and stay tracked. LLM v2 campaigns run
# under outputs/llm_v2/ (run cache, sandboxes, locks); their publication
# export under artifacts/llm_v2/ IS tracked (docs/llm_v2/ARTIFACT_POLICY.md).
outputs/

# Neuron compiler debug dumps / profiler traces (written next to the CWD by
# NEURON_FRAMEWORK_DEBUG=1; the NKI profiling flow keeps them under
# results/<gpu>/logs/nki_profiles/, which is already ignored)
*.neff
*.hlo_module.pb
*.ntff
PostSPMDPassesExecutionDuration.txt
