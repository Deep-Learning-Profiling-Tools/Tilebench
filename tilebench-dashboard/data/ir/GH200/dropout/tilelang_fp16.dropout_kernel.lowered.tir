# from tvm.script import ir as I
# from tvm.script import tirx as T

@I.ir_module
class Module:
    @T.prim_func
    def dropout_kernel_kernel(output: T.handle("float16", "global"), x: T.handle("float16", "global"), x_keep: T.handle("float16", "global")):
        T.func_attr({"calling_conv": 2, "target": T.target({"arch": "sm_90", "keys": ["cuda", "gpu"], "kind": "cuda", "max_num_threads": 1024, "tag": "", "thread_warp_size": 32}), "thread_extent": {"blockIdx.x": 20480, "threadIdx.x": 64, "threadIdx.y": 1, "threadIdx.z": 1}, "tirx.is_global_func": T.bool(True), "tirx.kernel_launch_params": ["blockIdx.x", "threadIdx.x", "threadIdx.y", "threadIdx.z"], "tirx.noalias": True, "tl.non_restrict_params": [], "tl.readonly_param_indices": [1, 2]})
        output_1 = T.decl_buffer((20971520,), "float16", data=output)
        x_keep_1 = T.decl_buffer((20971520,), "float16", data=x_keep)
        x_1 = T.decl_buffer((20971520,), "float16", data=x)
        bx = T.launch_thread("blockIdx.x", 20480)
        x_reg = T.alloc_buffer((16,), "float16", scope="local")
        x_keep_reg = T.alloc_buffer((16,), "float16", scope="local")
        output_reg = T.alloc_buffer((16,), "float16", scope="local")
        tx = T.launch_thread("threadIdx.x", 64)
        ty = T.launch_thread("threadIdx.y", 1)
        tz = T.launch_thread("threadIdx.z", 1)
        x_reg_1 = T.decl_buffer((16,), "float16", data=x_reg.data, scope="local")
        x_keep_reg_1 = T.decl_buffer((16,), "float16", data=x_keep_reg.data, scope="local")
        output_reg_1 = T.decl_buffer((16,), "float16", data=output_reg.data, scope="local")
        for i in T.unroll(2):
            x_reg_1[i * 8:i * 8 + 8] = x_1[bx * 1024 + i * 512 + tx * 8:bx * 1024 + i * 512 + tx * 8 + 8]
        for i in T.unroll(2):
            x_keep_reg_1[i * 8:i * 8 + 8] = x_keep_1[bx * 1024 + i * 512 + tx * 8:bx * 1024 + i * 512 + tx * 8 + 8]
        for i in T.unroll(16):
            output_reg_1[i] = T.Select(x_keep_reg_1[i] != T.float16(0.0), x_reg_1[i] * T.float16(2.0), T.float16(0.0))
        for i in T.unroll(2):
            output_1[bx * 1024 + i * 512 + tx * 8:bx * 1024 + i * 512 + tx * 8 + 8] = output_reg_1[i * 8:i * 8 + 8]