# from tvm.script import ir as I
# from tvm.script import tirx as T

@I.ir_module
class Module:
    @T.prim_func
    def max_pool2d_kernel_kernel(input: T.handle("bfloat16", "global"), output: T.handle("bfloat16", "global")):
        T.func_attr({"calling_conv": 2, "target": T.target({"arch": "sm_90", "keys": ["cuda", "gpu"], "kind": "cuda", "max_num_threads": 1024, "tag": "", "thread_warp_size": 32}), "thread_extent": {"blockIdx.x": 512, "blockIdx.y": 40, "blockIdx.z": 5, "threadIdx.x": 128, "threadIdx.y": 1, "threadIdx.z": 1}, "tirx.is_global_func": T.bool(True), "tirx.kernel_launch_params": ["blockIdx.x", "blockIdx.y", "blockIdx.z", "threadIdx.x", "threadIdx.y", "threadIdx.z"], "tirx.noalias": True, "tl.non_restrict_params": [], "tl.readonly_param_indices": [0]})
        output_1 = T.decl_buffer((52428800,), "bfloat16", data=output)
        input_1 = T.decl_buffer((209715200,), "bfloat16", data=input)
        bx = T.launch_thread("blockIdx.x", 512)
        acc = T.alloc_buffer((4,), "bfloat16", scope="local")
        by = T.launch_thread("blockIdx.y", 40)
        bz = T.launch_thread("blockIdx.z", 5)
        tx = T.launch_thread("threadIdx.x", 128)
        ty = T.launch_thread("threadIdx.y", 1)
        tz = T.launch_thread("threadIdx.z", 1)
        acc_1 = T.decl_buffer((4,), "bfloat16", data=acc.data, scope="local")
        neg_inf: T.bfloat16 = T.infinity("bfloat16") * T.bfloat16(-1.0)
        acc_1[0:4] = T.Broadcast(T.infinity("bfloat16") * T.bfloat16(-1.0), 4)
        for kh in T.unroll(3):
            for kw in T.unroll(3):
                for i in T.unroll(4):
                    acc_1[i] = T.max(acc_1[i], T.if_then_else(1 <= bz * 128 + tx % 64 * 2 + kw, T.if_then_else(1 <= by * 16 + i * 4 + tx // 64 * 2 + kh, input_1[bx * 409600 + by * 10240 + i * 2560 + tx // 64 * 1280 + kh * 640 + bz * 128 + tx % 64 * 2 + kw - 641], T.infinity("bfloat16") * T.bfloat16(-1.0)), T.infinity("bfloat16") * T.bfloat16(-1.0)))
        for i in T.unroll(4):
            output_1[bx * 102400 + by * 2560 + i * 640 + tx // 64 * 320 + bz * 64 + tx % 64] = acc_1[i]