# from tvm.script import tirx as T

@T.prim_func
def z_kernel(Z: T.handle, PhiK: T.handle):
    Z_1 = T.match_buffer(Z, (256,), strides=(1,))
    PhiK_1 = T.match_buffer(PhiK, (10000, 256), strides=(256, 1))
    # with T.sblock("root"):
    bx = T.launch_thread("blockIdx.x", 8)
    tx = T.launch_thread("threadIdx.x", 128)
    ty = T.launch_thread("threadIdx.y", 1)
    tz = T.launch_thread("threadIdx.z", 1)
    with T.sblock("tilelang_root"):
        T.reads()
        T.writes()
        T.sblock_attr({"safe_value_map": {PhiK_1.data: 0.0}})
        k_frag = T.sblock_alloc_buffer((32, 32), scope="local.fragment")
        tile_sum = T.sblock_alloc_buffer((32,), scope="local.fragment")
        acc = T.sblock_alloc_buffer((32,), scope="local.fragment")
        d_start: T.int32 = bx * 32
        T.fill(T.region(acc[0], 2, 32), 0)
        for _tmp in range(313):
            m_start: T.int32 = _tmp * 32
            T.copy(T.region(PhiK_1[m_start, d_start], 1, 32, 32), T.region(k_frag[0, 0], 2, 32, 32))
            T.reduce(T.region(k_frag[0, 0], 1, 32, 32), T.region(tile_sum[0], 2, 32), "sum", 0, T.bool(True))
            for j in T.parallel(32):
                acc[j] = acc[j] + tile_sum[j]
        T.copy(T.region(acc[0], 1, 32), T.region(Z_1[d_start], 2, 32))