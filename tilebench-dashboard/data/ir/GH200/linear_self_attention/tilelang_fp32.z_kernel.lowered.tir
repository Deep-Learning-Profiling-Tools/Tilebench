# from tvm.script import ir as I
# from tvm.script import tirx as T

@I.ir_module
class Module:
    @T.prim_func
    def z_kernel_kernel(PhiK: T.handle("float32", "global"), Z: T.handle("float32", "global")):
        T.func_attr({"calling_conv": 2, "dyn_shared_memory_buf": 512, "target": T.target({"arch": "sm_90", "keys": ["cuda", "gpu"], "kind": "cuda", "max_num_threads": 1024, "tag": "", "thread_warp_size": 32}), "thread_extent": {"blockIdx.x": 8, "threadIdx.x": 128, "threadIdx.y": 1, "threadIdx.z": 1}, "tirx.is_global_func": T.bool(True), "tirx.kernel_launch_params": ["blockIdx.x", "threadIdx.x", "threadIdx.y", "threadIdx.z", "tirx.use_dyn_shared_memory"], "tirx.noalias": True, "tl.non_restrict_params": [], "tl.readonly_param_indices": [0]})
        Z_1 = T.decl_buffer((256,), data=Z)
        PhiK_1 = T.decl_buffer((2560000,), data=PhiK)
        bx = T.launch_thread("blockIdx.x", 8)
        acc = T.alloc_buffer((4,), scope="local")
        k_frag = T.alloc_buffer((8,), scope="local")
        tile_sum = T.alloc_buffer((4,), scope="local")
        workspace = T.alloc_buffer((128,), scope="shared.dyn")
        tx = T.launch_thread("threadIdx.x", 128)
        ty = T.launch_thread("threadIdx.y", 1)
        tz = T.launch_thread("threadIdx.z", 1)
        acc_1 = T.decl_buffer((4,), data=acc.data, scope="local")
        acc_1[0:4] = T.Broadcast(T.float32(0.0), 4)
        for _tmp in range(313):
            k_frag_1 = T.decl_buffer((8,), data=k_frag.data, scope="local")
            tile_sum_1 = T.decl_buffer((4,), data=tile_sum.data, scope="local")
            for i in T.unroll(2):
                k_frag_1[i * 4:i * 4 + 4] = T.if_then_else(_tmp * 2 + i < 625, PhiK_1[_tmp * 8192 + i * 4096 + tx // 8 * 256 + bx * 32 + tx % 8 * 4:_tmp * 8192 + i * 4096 + tx // 8 * 256 + bx * 32 + tx % 8 * 4 + 4], T.Broadcast(T.float32(0.0), 4))
            T.tvm_storage_sync("shared.dyn")
            for i in T.unroll(4):
                tile_sum_1[i] = T.float32(0.0)
                for rv in T.unroll(2):
                    tile_sum_1[i] = tile_sum_1[i] + k_frag_1[rv * 4 + i]
                tile_sum_1[i] = T.call_extern("float32", "tl::AllReduce<tl::SumOp, 128, 8, 0, tl::NamedBarrier<128>>::run", tile_sum_1[i], T.tvm_access_ptr(T.type_annotation("float32"), workspace.data, 0, 128, 2))
            for i in T.unroll(4):
                acc_1[i] = acc_1[i] + tile_sum_1[i]
        if tx // 8 == 0:
            Z_1[bx * 32 + tx % 8 * 4:bx * 32 + tx % 8 * 4 + 4] = acc_1[0:4]