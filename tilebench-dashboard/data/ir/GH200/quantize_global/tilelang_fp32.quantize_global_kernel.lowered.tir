# from tvm.script import ir as I
# from tvm.script import tirx as T

@I.ir_module
class Module:
    @T.prim_func
    def quantize_global_kernel_kernel(output: T.handle("float16", "global"), x: T.handle("float32", "global")):
        T.func_attr({"calling_conv": 2, "target": T.target({"arch": "sm_90", "keys": ["cuda", "gpu"], "kind": "cuda", "max_num_threads": 1024, "tag": "", "thread_warp_size": 32}), "thread_extent": {"blockIdx.x": 2560, "threadIdx.x": 128, "threadIdx.y": 1, "threadIdx.z": 1}, "tirx.is_global_func": T.bool(True), "tirx.kernel_launch_params": ["blockIdx.x", "threadIdx.x", "threadIdx.y", "threadIdx.z"], "tirx.noalias": True, "tl.non_restrict_params": [], "tl.readonly_param_indices": [1]})
        output_1 = T.decl_buffer((20971520,), "float16", data=output)
        x_1 = T.decl_buffer((20971520,), data=x)
        bx = T.launch_thread("blockIdx.x", 2560)
        x_local_cast_1 = T.alloc_buffer((4,), scope="local")
        output_local_cast = T.alloc_buffer((4,), "float16", scope="local")
        tx = T.launch_thread("threadIdx.x", 128)
        ty = T.launch_thread("threadIdx.y", 1)
        tz = T.launch_thread("threadIdx.z", 1)
        for i in T.unroll(16):
            x_local_cast_1[0:4] = x_1[bx * 8192 + i * 512 + tx * 4:bx * 8192 + i * 512 + tx * 4 + 4]
            output_local_cast[0:4] = T.Cast("float16x4", x_local_cast_1[0:4])
            output_1[bx * 8192 + i * 512 + tx * 4:bx * 8192 + i * 512 + tx * 4 + 4] = output_local_cast[0:4]