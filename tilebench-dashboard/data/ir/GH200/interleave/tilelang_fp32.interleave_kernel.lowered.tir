# from tvm.script import ir as I
# from tvm.script import tirx as T

@I.ir_module
class Module:
    @T.prim_func
    def interleave_kernel_kernel(A: T.handle("float32", "global"), B: T.handle("float32", "global"), output: T.handle("float32", "global")):
        T.func_attr({"calling_conv": 2, "target": T.target({"arch": "sm_90", "keys": ["cuda", "gpu"], "kind": "cuda", "max_num_threads": 1024, "tag": "", "thread_warp_size": 32}), "thread_extent": {"blockIdx.x": 19532, "threadIdx.x": 256, "threadIdx.y": 1, "threadIdx.z": 1}, "tirx.is_global_func": T.bool(True), "tirx.kernel_launch_params": ["blockIdx.x", "threadIdx.x", "threadIdx.y", "threadIdx.z"], "tirx.noalias": True, "tl.non_restrict_params": [], "tl.readonly_param_indices": [0, 1]})
        output_1 = T.decl_buffer((40000000,), data=output)
        B_1 = T.decl_buffer((20000000,), data=B)
        A_1 = T.decl_buffer((20000000,), data=A)
        bx = T.launch_thread("blockIdx.x", 19532)
        A_reg = T.alloc_buffer((4,), scope="local")
        B_reg = T.alloc_buffer((4,), scope="local")
        output_reg = T.alloc_buffer((8,), scope="local")
        tx = T.launch_thread("threadIdx.x", 256)
        ty = T.launch_thread("threadIdx.y", 1)
        tz = T.launch_thread("threadIdx.z", 1)
        A_reg_1 = T.decl_buffer((4,), data=A_reg.data, scope="local")
        B_reg_1 = T.decl_buffer((4,), data=B_reg.data, scope="local")
        output_reg_1 = T.decl_buffer((8,), data=output_reg.data, scope="local")
        A_reg_1[0:4] = T.if_then_else(bx * 4 + tx // 64 < 78125, A_1[bx * 1024 + tx * 4:bx * 1024 + tx * 4 + 4], T.Broadcast(T.float32(0.0), 4))
        B_reg_1[0:4] = T.if_then_else(bx * 4 + tx // 64 < 78125, B_1[bx * 1024 + tx * 4:bx * 1024 + tx * 4 + 4], T.Broadcast(T.float32(0.0), 4))
        for i in T.unroll(8):
            output_reg_1[i] = T.Select(i % 2 == 0, A_reg_1[i // 2], B_reg_1[i // 2])
        if bx * 4 + tx // 64 < 78125:
            for i in T.unroll(2):
                output_1[bx * 2048 + tx * 8 + i * 4:bx * 2048 + tx * 8 + i * 4 + 4] = output_reg_1[i * 4:i * 4 + 4]