            lo: T.float32 = T.Select(b < a, b, a)
            left_desc: T.bool = T.bitwise_and(i * 512 + tx // 2 * 4 + tx % 2, 4096) == 0
            workspace_1[i * 512 + tx // 2 * 4 + tx % 2] = T.Select(T.bitwise_and(i * 512 + tx // 2 * 4 + tx % 2, 4096) == 0, T.Select(b < a, a, b), T.Select(b < a, b, a))
            workspace_1[i * 512 + tx // 2 * 4 + tx % 2 + 2] = T.Select(T.bitwise_and(i * 512 + tx // 2 * 4 + tx % 2, 4096) == 0, T.Select(b < a, b, a), T.Select(b < a, a, b))
        T.tvm_storage_sync("shared")
        for i in T.unroll(8):
            a: T.float32 = workspace_1[i * 512 + tx * 2]
            b: T.float32 = workspace_1[i * 512 + tx * 2 + 1]
            hi: T.float32 = T.Select(b < a, a, b)
            lo: T.float32 = T.Select(b < a, b, a)
            left_desc: T.bool = T.bitwise_and(i * 512 + tx * 2, 4096) == 0
            workspace_1[i * 512 + tx * 2] = T.Select(T.bitwise_and(i * 512 + tx * 2, 4096) == 0, T.Select(b < a, a, b), T.Select(b < a, b, a))
            workspace_1[i * 512 + tx * 2 + 1] = T.Select(T.bitwise_and(i * 512 + tx * 2, 4096) == 0, T.Select(b < a, b, a), T.Select(b < a, a, b))
        T.tvm_storage_sync("shared")
        output_1[bx * 1024 + tx * 4:bx * 1024 + tx * 4 + 4] = workspace_1[tx * 4:tx * 4 + 4]