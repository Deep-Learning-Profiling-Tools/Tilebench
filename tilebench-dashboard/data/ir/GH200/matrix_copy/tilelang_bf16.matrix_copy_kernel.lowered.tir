# from tvm.script import ir as I
# from tvm.script import tirx as T

@I.ir_module
class Module:
    @T.prim_func
    def matrix_copy_kernel_kernel(A: T.handle("bfloat16", "global"), B: T.handle("bfloat16", "global")):
        T.func_attr({"calling_conv": 2, "target": T.target({"arch": "sm_90", "keys": ["cuda", "gpu"], "kind": "cuda", "max_num_threads": 1024, "tag": "", "thread_warp_size": 32}), "thread_extent": {"blockIdx.x": 6400, "threadIdx.x": 128, "threadIdx.y": 1, "threadIdx.z": 1}, "tirx.is_global_func": T.bool(True), "tirx.kernel_launch_params": ["blockIdx.x", "threadIdx.x", "threadIdx.y", "threadIdx.z"], "tirx.noalias": True, "tl.non_restrict_params": [], "tl.readonly_param_indices": [0]})
        A_1 = T.decl_buffer((26214400,), "bfloat16", data=A)
        B_1 = T.decl_buffer((26214400,), "bfloat16", data=B)
        bx = T.launch_thread("blockIdx.x", 6400)
        tx = T.launch_thread("threadIdx.x", 128)
        ty = T.launch_thread("threadIdx.y", 1)
        tz = T.launch_thread("threadIdx.z", 1)
        for i in T.unroll(4):
            B_1[bx * 4096 + i * 1024 + tx * 8:bx * 4096 + i * 1024 + tx * 8 + 8] = A_1[bx * 4096 + i * 1024 + tx * 8:bx * 4096 + i * 1024 + tx * 8 + 8]