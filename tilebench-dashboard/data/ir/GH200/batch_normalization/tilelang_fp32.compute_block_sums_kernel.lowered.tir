# from tvm.script import ir as I
# from tvm.script import tirx as T

@I.ir_module
class Module:
    @T.prim_func
    def compute_block_sums_kernel_kernel(block_sq_sum: T.handle("float32", "global"), block_sum: T.handle("float32", "global"), input: T.handle("float32", "global")):
        T.func_attr({"calling_conv": 2, "target": T.target({"arch": "sm_90", "keys": ["cuda", "gpu"], "kind": "cuda", "max_num_threads": 1024, "tag": "", "thread_warp_size": 32}), "thread_extent": {"blockIdx.x": 313, "threadIdx.x": 128, "threadIdx.y": 1, "threadIdx.z": 1}, "tirx.is_global_func": T.bool(True), "tirx.kernel_launch_params": ["blockIdx.x", "threadIdx.x", "threadIdx.y", "threadIdx.z"], "tirx.noalias": True, "tl.non_restrict_params": [], "tl.readonly_param_indices": [2]})
        block_sq_sum_1 = T.decl_buffer((320512,), data=block_sq_sum)
        block_sum_1 = T.decl_buffer((320512,), data=block_sum)
        input_1 = T.decl_buffer((20480000,), data=input)
        bx = T.launch_thread("blockIdx.x", 313)
        acc_sum = T.alloc_buffer((8,), scope="local")
        acc_sq = T.alloc_buffer((8,), scope="local")
        input_local = T.alloc_buffer((64,), scope="local")
        input_sq_local = T.alloc_buffer((64,), scope="local")
        tile_sum = T.alloc_buffer((8,), scope="local")
        tile_sq_sum = T.alloc_buffer((8,), scope="local")
        tx = T.launch_thread("threadIdx.x", 128)
        ty = T.launch_thread("threadIdx.y", 1)
        tz = T.launch_thread("threadIdx.z", 1)
        acc_sum_1 = T.decl_buffer((8,), data=acc_sum.data, scope="local")
        acc_sq_1 = T.decl_buffer((8,), data=acc_sq.data, scope="local")
        for i in T.unroll(2):
            acc_sum_1[i * 4:i * 4 + 4] = T.Broadcast(T.float32(0.0), 4)
        for i in T.unroll(2):
            acc_sq_1[i * 4:i * 4 + 4] = T.Broadcast(T.float32(0.0), 4)
        for _tmp in T.unroll(8):
            input_local_1 = T.decl_buffer((64,), data=input_local.data, scope="local")
            input_sq_local_1 = T.decl_buffer((64,), data=input_sq_local.data, scope="local")
            tile_sum_1 = T.decl_buffer((8,), data=tile_sum.data, scope="local")
            tile_sq_sum_1 = T.decl_buffer((8,), data=tile_sq_sum.data, scope="local")
            for i in T.unroll(16):
                input_local_1[i * 4:i * 4 + 4] = T.if_then_else(bx * 2 + _tmp // 4 < 625, input_1[bx * 65536 + _tmp * 8192 + i * 512 + tx * 4:bx * 65536 + _tmp * 8192 + i * 512 + tx * 4 + 4], T.Broadcast(T.float32(0.0), 4))
                input_sq_local_1[i * 4:i * 4 + 4] = input_local_1[i * 4:i * 4 + 4] * input_local_1[i * 4:i * 4 + 4]
            for i in T.unroll(8):
                tile_sum_1[i] = T.float32(0.0)
                for rv in T.unroll(8):
                    tile_sum_1[i] = tile_sum_1[i] + input_local_1[rv * 8 + i]
            for i in T.unroll(8):
                tile_sq_sum_1[i] = T.float32(0.0)
                for rv in T.unroll(8):
                    tile_sq_sum_1[i] = tile_sq_sum_1[i] + input_sq_local_1[rv * 8 + i]
            for i in T.unroll(8):
                acc_sum_1[i] = acc_sum_1[i] + tile_sum_1[i]
                acc_sq_1[i] = acc_sq_1[i] + tile_sq_sum_1[i]
        for i in T.unroll(2):
            block_sum_1[bx * 1024 + i * 512 + tx * 4:bx * 1024 + i * 512 + tx * 4 + 4] = acc_sum_1[i * 4:i * 4 + 4]
        for i in T.unroll(2):
            block_sq_sum_1[bx * 1024 + i * 512 + tx * 4:bx * 1024 + i * 512 + tx * 4 + 4] = acc_sq_1[i * 4:i * 4 + 4]