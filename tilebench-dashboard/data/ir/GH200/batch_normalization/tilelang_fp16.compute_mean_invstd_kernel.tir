# from tvm.script import tirx as T

@T.prim_func
def compute_mean_invstd_kernel(block_sum: T.handle, block_sq_sum: T.handle, mean: T.handle, inv_std: T.handle):
    block_sum_1 = T.match_buffer(block_sum, (313, 1024), strides=(1024, 1))
    block_sq_sum_1 = T.match_buffer(block_sq_sum, (313, 1024), strides=(1024, 1))
    mean_1 = T.match_buffer(mean, (1024,), strides=(1,))
    inv_std_1 = T.match_buffer(inv_std, (1024,), strides=(1,))
    # with T.sblock("root"):
    bx = T.launch_thread("blockIdx.x", 1024)
    tx = T.launch_thread("threadIdx.x", 128)
    ty = T.launch_thread("threadIdx.y", 1)
    tz = T.launch_thread("threadIdx.z", 1)
    with T.sblock("tilelang_root"):
        T.reads()
        T.writes()
        sums = T.sblock_alloc_buffer((512, 1), scope="local.fragment")
        sq_sums = T.sblock_alloc_buffer((512, 1), scope="local.fragment")
        total_sum = T.sblock_alloc_buffer((1,), scope="local.fragment")
        total_sq_sum = T.sblock_alloc_buffer((1,), scope="local.fragment")
        mean_local = T.sblock_alloc_buffer((1,), scope="local.fragment")
        inv_std_local = T.sblock_alloc_buffer((1,), scope="local.fragment")
        T.copy(T.region(block_sum_1[0, bx], 1, 512, 1), T.region(sums[0, 0], 2, 512, 1))
        T.copy(T.region(block_sq_sum_1[0, bx], 1, 512, 1), T.region(sq_sums[0, 0], 2, 512, 1))
        T.reduce(T.region(sums[0, 0], 1, 512, 1), T.region(total_sum[0], 2, 1), "sum", 0, T.bool(True))
        T.reduce(T.region(sq_sums[0, 0], 1, 512, 1), T.region(total_sq_sum[0], 2, 1), "sum", 0, T.bool(True))
        mean_local[0] = total_sum[0] / T.float32(20000.0)
        var_raw: T.float32 = total_sq_sum[0] / T.float32(20000.0) - mean_local[0] * mean_local[0]
        var_clamped: T.float32 = T.max(var_raw, T.float32(0.0))
        inv_std_local[0] = T.rsqrt(var_clamped + T.float32(1.0000000000000001e-05))
        T.copy(T.region(mean_local[0], 1, 1), T.region(mean_1[bx], 2, 1))
        T.copy(T.region(inv_std_local[0], 1, 1), T.region(inv_std_1[bx], 2, 1))