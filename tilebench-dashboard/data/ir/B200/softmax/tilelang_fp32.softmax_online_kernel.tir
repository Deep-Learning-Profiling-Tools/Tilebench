# from tvm.script import tirx as T

@T.prim_func
def softmax_online_kernel(x: T.handle, y: T.handle):
    M = T.int32()
    x_1 = T.match_buffer(x, (M, 10240), strides=(10240, 1))
    y_1 = T.match_buffer(y, (M, 10240), strides=(10240, 1))
    # with T.sblock("root"):
    bx = T.launch_thread("blockIdx.x", M)
    tx = T.launch_thread("threadIdx.x", 128)
    ty = T.launch_thread("threadIdx.y", 1)
    tz = T.launch_thread("threadIdx.z", 1)
    with T.sblock("tilelang_root"):
        T.reads()
        T.writes()
        T.sblock_attr({"safe_value_map": {x_1.data: T.infinity("float32") * T.float32(-1.0)}})
        X_local = T.sblock_alloc_buffer((2048,), scope="local.fragment")
        Y_local = T.sblock_alloc_buffer((2048,), scope="local.fragment")
        x_exp_local = T.sblock_alloc_buffer((2048,), scope="local.fragment")
        tile_sum_local = T.sblock_alloc_buffer((1,), scope="local.fragment")
        l = T.sblock_alloc_buffer((1,), scope="local.fragment")
        running_max = T.sblock_alloc_buffer((1,), scope="local.fragment")
        tile_max = T.sblock_alloc_buffer((1,), scope="local.fragment")
        past_max = T.sblock_alloc_buffer((1,), scope="local.fragment")
        l[0] = T.float32(0.0)
        running_max[0] = T.infinity("float32") * T.float32(-1.0)
        past_max[0] = T.infinity("float32") * T.float32(-1.0)
        for _tmp in range(5):
            start: T.int32 = _tmp * 2048
            end: T.int32 = T.min(start + 2048, 10240)
            T.fill(T.region(X_local[0], 2, 2048), T.infinity("float32") * T.float32(-1.0))
            T.fill(T.region(x_exp_local[0], 2, 2048), T.float32(0.0))
            for i in T.parallel(2048):
                col: T.int32 = start + i
                X_local[i] = T.Cast("float32", x_1[bx, col])
            T.reduce(T.region(X_local[0], 1, 2048), T.region(tile_max[0], 2, 1), "max", 0, T.bool(True))
            running_max[0] = T.max(running_max[0], tile_max[0])
            for i in T.parallel(2048):
                col: T.int32 = start + i
                if col < 10240:
                    x_exp_local[i] = T.exp(X_local[i] - running_max[0])
            T.reduce(T.region(x_exp_local[0], 1, 2048), T.region(tile_sum_local[0], 2, 1), "sum", 0, T.bool(True))
            l[0] = l[0] * T.exp(past_max[0] - running_max[0]) + tile_sum_local[0]
            past_max[0] = running_max[0]
        for _tmp in range(5):
            start: T.int32 = _tmp * 2048
            end: T.int32 = T.min(start + 2048, 10240)
            T.copy(T.region(x_1[bx, start], 1, 1, end - start), T.region(X_local[0], 2, 2048))
            coef: T.float32 = T.float32(1.0) / l[0]
            for i in T.parallel(2048):
                col: T.int32 = start + i
                if col < 10240:
                    Y_local[i] = T.Cast("float32", T.exp(X_local[i] - running_max[0]) * coef)
            T.copy(T.region(Y_local[0], 1, 2048), T.region(y_1[bx, start], 2, 1, end - start))