                    output_flat_1[output_idx] = T.Cast("float16", acc_1[i])
        if tx // 32 == 0:
            T.ptx_deallocate_tensor_memory(T.tvm_access_ptr(T.type_annotation("uint32"), acc_tmem.data, 0, 1, 1), 128)