            desc_a_1 = T.decl_buffer((1,), "uint64", data=desc_a.data, scope="local.descriptor.tcgen05_smem")
            desc_b_1 = T.decl_buffer((1,), "uint64", data=desc_b.data, scope="local.descriptor.tcgen05_smem")
            if tx // 32 == 0:
                T.initialize_tcgen05_descriptor(desc_a_1[0], T.tvm_access_ptr(T.type_annotation("float16"), input_tile, 0, 4096, 1), 1, 32, 0, 0, 4)
                T.initialize_tcgen05_descriptor(desc_b_1[0], T.tvm_access_ptr(T.type_annotation("float16"), weight_tile, 0, 4096, 1), 256, 64, 0, 0, 2)
                T.fence_proxy_async()
                for ki in T.unroll(2):
                    T.ptx_tcgen05_mma_ss("fp16", desc_a.data, ki * 32, desc_b.data, ki * 2048, acc_tmem.data, 0, 136380432, T.Select(0 < ki, 1, T.Select(feat_block == 0, 0, 1)), 0, 0, 0, 0, 0, 0)
                T.tcgen05_mma_arrive(T.tvm_access_ptr(T.type_annotation("uint64"), mbar.data, 0, 1, 3))
            T.mbarrier_wait_parity(mbar_1[0], feat_block % 2)
