# from tvm.script import ir as I
# from tvm.script import tirx as T

@I.ir_module
class Module:
    @T.prim_func
    def matrix_transpose_kernel_kernel(output_desc: T.handle("uint8x128", "grid_constant"), x: T.handle("float32", "global")):
        T.func_attr({"calling_conv": 2, "dyn_shared_memory_buf": 8192, "target": T.target({"arch": "sm_100", "keys": ["cuda", "gpu"], "kind": "cuda", "max_num_threads": 1024, "tag": "", "thread_warp_size": 32}), "thread_extent": {"blockIdx.x": 128, "blockIdx.y": 640, "threadIdx.x": 128, "threadIdx.y": 1, "threadIdx.z": 1}, "tirx.is_global_func": T.bool(True), "tirx.kernel_launch_params": ["blockIdx.x", "blockIdx.y", "threadIdx.x", "threadIdx.y", "threadIdx.z", "tirx.use_dyn_shared_memory"], "tirx.noalias": True, "tl.non_restrict_params": [], "tl.readonly_param_indices": [0, 1]})
        x_1 = T.decl_buffer((83886080,), data=x)
        bx = T.launch_thread("blockIdx.x", 128)
        buf_dyn_shmem = T.alloc_buffer((8192,), "uint8", scope="shared.dyn")
        tile: T.handle("float32", "shared.dyn") = T.handle_add_byte_offset(buf_dyn_shmem.data, 0)
        tile_T: T.handle("float32", "shared.dyn") = T.handle_add_byte_offset(buf_dyn_shmem.data, 4096)
        by = T.launch_thread("blockIdx.y", 640)
        tx = T.launch_thread("threadIdx.x", 128)
        if T.tl_shuffle_elect(0):
            T.call_extern("handle", "tl::prefetch_tma_descriptor", output_desc)
        ty = T.launch_thread("threadIdx.y", 1)
        tz = T.launch_thread("threadIdx.z", 1)
        tile_1 = T.decl_buffer((1024,), data=tile, scope="shared.dyn")
        tile_T_1 = T.decl_buffer((1024,), data=tile_T, scope="shared.dyn")
        for i in T.unroll(2):
            tile_1[i * 512 + tx * 4:i * 512 + tx * 4 + 4] = x_1[bx * 655360 + i * 327680 + tx // 8 * 20480 + by * 32 + tx % 8 * 4:bx * 655360 + i * 327680 + tx // 8 * 20480 + by * 32 + tx % 8 * 4 + 4]
        T.tvm_storage_sync("shared.dyn")
        for i in T.unroll(8):
            tile_T_1[tx % 32 * 32 + (i // 4 + tx % 8 // 4) % 2 * 16 + (i % 4 // 2 + tx % 4 // 2) % 2 * 8 + (i % 2 + tx % 2) % 2 * 4 + tx // 32] = tile_1[i * 128 + tx]
        T.tvm_storage_sync("shared.dyn")
        if T.tl_shuffle_elect(128):
            T.fence_proxy_async()
            T.tma_store(output_desc, T.tvm_access_ptr(T.type_annotation("float32"), tile_T, 0, 1024, 1), bx * 32, by * 32, 0, 0)
            T.tma_store_arrive()
            T.tma_store_wait(0, T.bool(True))