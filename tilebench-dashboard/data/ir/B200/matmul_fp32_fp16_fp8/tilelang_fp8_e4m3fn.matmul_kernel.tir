# from tvm.script import tirx as T

@T.prim_func
def matmul_kernel(a: T.handle, b: T.handle, c: T.handle):
    a_1 = T.match_buffer(a, (4096, 20480), "float8_e4m3fn", strides=(20480, 1))
    b_1 = T.match_buffer(b, (20480, 4096), "float8_e4m3fn", strides=(4096, 1))
    c_1 = T.match_buffer(c, (4096, 4096), "float8_e4m3fn", strides=(4096, 1))
    # with T.sblock("root"):
    bx = T.launch_thread("blockIdx.x", 16)
    by = T.launch_thread("blockIdx.y", 16)
    tx = T.launch_thread("threadIdx.x", 128)
    ty = T.launch_thread("threadIdx.y", 1)
    tz = T.launch_thread("threadIdx.z", 1)
    with T.sblock("tilelang_root"):
        T.reads()
        T.writes()
        mbar = T.handle("uint64", "shared.barrier")
        T.sblock_attr({"barrier_init": {mbar: [1]}})
        a_tile = T.sblock_alloc_buffer((256, 128), "float8_e4m3fn", scope="shared.dyn")
        b_tile = T.sblock_alloc_buffer((128, 256), "float8_e4m3fn", scope="shared.dyn")
        acc = T.sblock_alloc_buffer((256, 256), scope="local.fragment")
        acc_tmem = T.sblock_alloc_buffer((256, 256), scope="shared.tmem")
        mbar_1 = T.sblock_alloc_buffer((1,), "uint64", data=mbar, scope="shared.barrier")
        T.attr(None, "threadblock_swizzle_pattern", T.tvm_tuple("rasterization2DRow", 8))
        start_m: T.int32 = bx * 256
        start_n: T.int32 = by * 256
        for k in T.serial(160, annotations={"num_stages": 3}):
            T.copy(T.region(a_1[start_m, k * 128], 1, 256, 128), T.region(a_tile[0, 0], 2, 256, 128))
            T.copy(T.region(b_1[k * 128, start_n], 1, 128, 256), T.region(b_tile[0, 0], 2, 128, 256))
            T.gemm(T.region(a_tile[0, 0], 1, 256, 128), T.region(b_tile[0, 0], 1, 128, 256), T.region(acc_tmem[0, 0], 3, 256, 256), T.bool(False), T.bool(False), 256, 256, 128, 0, k == 0, 128, 256, 0, 0, 1, 0, mbar_1[0], 0, 0)
        T.copy(T.region(acc_tmem[0, 0], 1, 256, 256), T.region(acc[0, 0], 2, 256, 256))
        T.copy(T.region(acc[0, 0], 1, 256, 256), T.region(c_1[start_m, start_n], 2, 256, 256))