# from tvm.script import ir as I
# from tvm.script import tirx as T

@I.ir_module
class Module:
    @T.prim_func
    def main_kernel(dst: T.handle("int32", "global"), src: T.handle("int32", "global")):
        T.func_attr({"calling_conv": 2, "dyn_shared_memory_buf": 512, "target": T.target({"arch": "sm_100", "keys": ["cuda", "gpu"], "kind": "cuda", "max_num_threads": 1024, "tag": "", "thread_warp_size": 32}), "thread_extent": {"blockIdx.x": 77, "threadIdx.x": 128, "threadIdx.y": 1, "threadIdx.z": 1}, "tirx.is_global_func": T.bool(True), "tirx.kernel_launch_params": ["blockIdx.x", "threadIdx.x", "threadIdx.y", "threadIdx.z", "tirx.use_dyn_shared_memory"], "tirx.noalias": True, "tl.non_restrict_params": [], "tl.readonly_param_indices": [1]})
        dst_1 = T.decl_buffer((77,), "int32", data=dst)
        src_1 = T.decl_buffer((78128,), "int32", data=src)
        bx = T.launch_thread("blockIdx.x", 77)
        vals = T.alloc_buffer((8,), "int32", scope="local")
        total = T.alloc_buffer((1,), "int32", scope="local")
        workspace = T.alloc_buffer((128,), "int32", scope="shared.dyn")
        tx = T.launch_thread("threadIdx.x", 128)
        ty = T.launch_thread("threadIdx.y", 1)
        tz = T.launch_thread("threadIdx.z", 1)
        vals_1 = T.decl_buffer((8,), "int32", data=vals.data, scope="local")
        total_1 = T.decl_buffer((1,), "int32", data=total.data, scope="local")
        vals_1[0:8] = T.if_then_else(bx * 64 + tx // 2 < 4883, src_1[bx * 1024 + tx * 8:bx * 1024 + tx * 8 + 8], T.Broadcast(0, 8))
        total_1[0] = 0
        for rv in T.unroll(8):
            total_1[0] = total_1[0] + vals_1[rv]
        total_1[0] = T.call_extern("int32", "tl::AllReduce<tl::SumOp, 128, 1, 0, tl::NamedBarrier<128>>::run", total_1[0], T.tvm_access_ptr(T.type_annotation("int32"), workspace.data, 0, 128, 2))
        dst_1[bx] = total_1[0]