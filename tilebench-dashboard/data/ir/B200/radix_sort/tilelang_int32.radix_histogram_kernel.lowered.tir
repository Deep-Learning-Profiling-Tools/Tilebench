# from tvm.script import ir as I
# from tvm.script import tirx as T

@I.ir_module
class Module:
    @T.prim_func
    def main_kernel(hist: T.handle("int32", "global"), input: T.handle("int32", "global"), shift: T.int32):
        T.func_attr({"calling_conv": 2, "dyn_shared_memory_buf": 1024, "target": T.target({"arch": "sm_100", "keys": ["cuda", "gpu"], "kind": "cuda", "max_num_threads": 1024, "tag": "", "thread_warp_size": 32}), "thread_extent": {"blockIdx.x": 19532, "threadIdx.x": 128, "threadIdx.y": 1, "threadIdx.z": 1}, "tirx.is_global_func": T.bool(True), "tirx.kernel_launch_params": ["blockIdx.x", "threadIdx.x", "threadIdx.y", "threadIdx.z", "tirx.use_dyn_shared_memory"], "tirx.noalias": True, "tl.non_restrict_params": [], "tl.readonly_param_indices": [1]})
        hist_1 = T.decl_buffer((78128,), "int32", data=hist)
        input_1 = T.decl_buffer((20000000,), "int32", data=input)
        bx = T.launch_thread("blockIdx.x", 19532)
        packed = T.alloc_buffer((8,), "int64", scope="local")
        input_local_cast = T.alloc_buffer((4,), "int32", scope="local")
        total = T.alloc_buffer((1,), "int64", scope="local")
        workspace = T.alloc_buffer((128,), "int64", scope="shared.dyn")
        tx = T.launch_thread("threadIdx.x", 128)
        ty = T.launch_thread("threadIdx.y", 1)
        tz = T.launch_thread("threadIdx.z", 1)
        packed_1 = T.decl_buffer((8,), "int64", data=packed.data, scope="local")
        total_1 = T.decl_buffer((1,), "int64", data=total.data, scope="local")
        for i in T.unroll(2):
            input_local_cast[0:4] = T.if_then_else(bx * 4 + i * 2 + tx // 64 < 78125, input_1[bx * 1024 + i * 512 + tx * 4:bx * 1024 + i * 512 + tx * 4 + 4], T.Broadcast(0, 4))
            for vec in range(2):
                packed_1[i * 4 + vec * 2:i * 4 + vec * 2 + 2] = T.shift_left(T.Broadcast(T.Cast("int64", bx * 4 + i * 2 + tx // 64 < 78125), 2), T.Cast("int64x2", T.bitwise_and(T.shift_right(input_local_cast[vec * 2:vec * 2 + 2], T.Broadcast(shift, 2)), T.Broadcast(3, 2))) * T.Broadcast(T.int64(16), 2))
        total_1[0] = T.int64(0)
        for rv in T.unroll(8):
            total_1[0] = total_1[0] + packed_1[rv % 2 * 4 + rv // 2]
        total_1[0] = T.call_extern("int64", "tl::AllReduce<tl::SumOp, 128, 1, 0, tl::NamedBarrier<128>>::run", total_1[0], T.tvm_access_ptr(T.type_annotation("int64"), workspace.data, 0, 128, 2))
        if tx // 4 == 0:
            hist_1[tx % 4 * 19532 + bx] = T.Cast("int32", T.bitwise_and(T.shift_right(total_1[0], T.Cast("int64", tx) % T.int64(4) * T.int64(16)), T.int64(65535)))