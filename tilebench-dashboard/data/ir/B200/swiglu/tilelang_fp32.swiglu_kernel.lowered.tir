# from tvm.script import ir as I
# from tvm.script import tirx as T

@I.ir_module
class Module:
    @T.prim_func
    def swiglu_kernel_kernel(output: T.handle("float32", "global"), x: T.handle("float32", "global"), y: T.handle("float32", "global")):
        T.func_attr({"calling_conv": 2, "target": T.target({"arch": "sm_100", "keys": ["cuda", "gpu"], "kind": "cuda", "max_num_threads": 1024, "tag": "", "thread_warp_size": 32}), "thread_extent": {"blockIdx.x": 40960, "threadIdx.x": 256, "threadIdx.y": 1, "threadIdx.z": 1}, "tirx.is_global_func": T.bool(True), "tirx.kernel_launch_params": ["blockIdx.x", "threadIdx.x", "threadIdx.y", "threadIdx.z"], "tirx.noalias": True, "tl.non_restrict_params": [], "tl.readonly_param_indices": [1, 2]})
        output_1 = T.decl_buffer((83886080,), data=output)
        y_1 = T.decl_buffer((83886080,), data=y)
        x_1 = T.decl_buffer((83886080,), data=x)
        bx = T.launch_thread("blockIdx.x", 40960)
        tx = T.launch_thread("threadIdx.x", 256)
        ty = T.launch_thread("threadIdx.y", 1)
        tz = T.launch_thread("threadIdx.z", 1)
        x_f32: T.float32x8 = x_1[bx * 2048 + tx * 8:bx * 2048 + tx * 8 + 8]
        y_f32: T.float32x8 = y_1[bx * 2048 + tx * 8:bx * 2048 + tx * 8 + 8]
        output_1[bx * 2048 + tx * 8:bx * 2048 + tx * 8 + 8] = x_f32 * T.sigmoid(x_f32) * y_f32