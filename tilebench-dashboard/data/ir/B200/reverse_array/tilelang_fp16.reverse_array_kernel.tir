# from tvm.script import tirx as T

@T.prim_func
def reverse_array_kernel(input: T.handle, output: T.handle):
    input_1 = T.match_buffer(input, (20000000,), "float16", strides=(1,))
    output_1 = T.match_buffer(output, (20000000,), "float16", strides=(1,))
    # with T.sblock("root"):
    bx = T.launch_thread("blockIdx.x", 19532)
    tx = T.launch_thread("threadIdx.x", 128)
    ty = T.launch_thread("threadIdx.y", 1)
    tz = T.launch_thread("threadIdx.z", 1)
    with T.sblock("tilelang_root"):
        T.reads()
        T.writes()
        for local_idx in T.parallel(1024):
            idx: T.int32 = local_idx + bx * 1024
            output_1[idx] = input_1[19999999 - idx]