# from tvm.script import ir as I
# from tvm.script import tirx as T

@I.ir_module
class Module:
    @T.prim_func
    def weight_dequant_kernel_kernel(S: T.handle("float32", "global"), X: T.handle("float32", "global"), output: T.handle("float32", "global")):
        T.func_attr({"calling_conv": 2, "target": T.target({"arch": "sm_100", "keys": ["cuda", "gpu"], "kind": "cuda", "max_num_threads": 1024, "tag": "", "thread_warp_size": 32}), "thread_extent": {"blockIdx.x": 51200, "threadIdx.x": 256, "threadIdx.y": 1, "threadIdx.z": 1}, "tirx.is_global_func": T.bool(True), "tirx.kernel_launch_params": ["blockIdx.x", "threadIdx.x", "threadIdx.y", "threadIdx.z"], "tirx.noalias": True, "tl.non_restrict_params": [], "tl.readonly_param_indices": [0, 1]})
        output_1 = T.decl_buffer((104857600,), data=output)
        S_1 = T.decl_buffer((6400,), data=S)
        X_1 = T.decl_buffer((104857600,), data=X)
        bx = T.launch_thread("blockIdx.x", 51200)
        tx = T.launch_thread("threadIdx.x", 256)
        ty = T.launch_thread("threadIdx.y", 1)
        tz = T.launch_thread("threadIdx.z", 1)
        value: T.float32x8 = X_1[bx * 2048 + tx * 8:bx * 2048 + tx * 8 + 8] * T.Broadcast(S_1[bx // 640 * 80 + bx % 5 * 16 + tx // 16], 8)
        output_1[bx * 2048 + tx * 8:bx * 2048 + tx * 8 + 8] = value