# Enables the performance query agent at /api/agent.
OPENROUTER_API_KEY=

# Optional model override (defaults to openai/gpt-5.6-luna).
TILEBENCH_AGENT_MODEL=

# Optional attribution headers sent to OpenRouter.
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=TileBench Dashboard

# Optional: attach Vercel KV / Upstash Redis to make notes durable.
# Without these the notes store is per-instance and resets.
KV_REST_API_URL=
KV_REST_API_TOKEN=
