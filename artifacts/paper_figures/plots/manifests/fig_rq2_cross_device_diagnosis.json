   "no cross-vendor numeric counter axis"
  ],
  "selected": [
   {
    "case": "matmul_fp32_fp16_fp8/fp32",
    "mechanism": "matrix operand delivery",
    "why": "the cuTile/Triton ranking reverses between B200 and GH200; dynamic TMA bytes and shared-memory store counts differ by device; MI300X lowers the same TensorDescriptor source to 32-bit pointer loads (static ISA) with a diagnostic pointer-load variant",
    "caveats": [
     "Triton reads a transposed B copy prepared outside the timed region; cuTile loads B as [K, N]",
     "cuTile winner tile differs (256x256x64 on B200, 128x128x32 on GH200) and cuda-tile differs (1.3.0 vs 1.5.0)"
    ]
   },
   {
    "case": "destindex/int8",
    "mechanism": "indexing overhead",
    "why": "identical store sectors but 16x more (byte-wide) store instructions and ~17x more instructions for cuTile on both NVIDIA devices; Triton keeps 128-bit stores on NVIDIA but compiles to per-lane byte stores on MI300X (static ISA)",
    "caveats": [
     "the PyTorch baseline (ATen index_copy) differs between vendors"
    ]
   },
   {
    "case": "1d_conv/fp16",
    "mechanism": "memory access and latency hiding",
    "why": "TileLang touches 7-10x more L1 load sectors than Triton with the same 16-bit load width and DRAM traffic, at lower occupancy and issue activity; on MI300X Triton's speedup rises because the PyTorch baseline runs MIOpen implicit GEMM plus layout transposes",
    "caveats": [
     "TileLang uses a different kernel body on Hopper",
     "the MI300X change is a baseline (PyTorch path) effect"
    ]
   }
  ],
  "not_selected": {
   "weight_dequant/bf16": "GH200 Triton instruction inflation is attributable to a different autotuned winner (config effect, not architecture); kept for Figure A5 as a confounder example",
