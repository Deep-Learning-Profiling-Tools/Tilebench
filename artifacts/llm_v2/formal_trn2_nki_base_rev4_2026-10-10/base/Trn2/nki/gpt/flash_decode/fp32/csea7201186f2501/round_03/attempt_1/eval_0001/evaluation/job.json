 "tolerance_source": "config.verify+dtype_default",
 "rules": {
  "schema": "tilebench-evaluator-rules/1",
  "operator": "flash_decode",
  "contract_revision": 2,
  "required_stages": [
   {
    "id": "s1",
    "description": "Per (batch, head): valid split count nb = ceil(b_seqlen[b] / block_seq) read from b_seqlen on the device."
   },
   {
    "id": "s2",
    "description": "fp32 log-sum-exp weighted combine over the valid splits inside one program per (batch, head) (online running-max recurrence in any order or in chunks, max pass then weighted-sum pass, or max and sums over the split axis held on chip); invalid splits skipped or neutralised."
   },
   {
    "id": "s3",
    "description": "Single final normalisation numerator / denominator (epsilon optional), rounded to mid_o.dtype and stored into a freshly allocated (batch, heads, head_dim) output; no global intermediate and no cross-program combine over splits."
   }
  ],
  "forbidden_substitutions": [
   {
    "pattern": "torch\\.(exp|max|amax|sum|logsumexp|softmax|log_softmax)\\(|\\.masked_fill_?\\(|\\.softmax\\(|torch\\.special\\.logsumexp",
    "message": "host-side tensor arithmetic performs the combine",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "scaled_dot_product_attention|torch\\.(matmul|bmm|einsum)\\(",
    "message": "attention recomputation is not part of stage 2",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "torch\\.(zeros|zeros_like|full|empty_like|arange|clone)\\(|\\.clone\\(\\)",
    "message": "extra buffer or clone; only the output allocation is permitted",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "torch\\.cuda\\.synchronize|b_seqlen\\.(item|cpu|tolist|max|min)\\(",
    "message": "host readback of b_seqlen; the valid count must be derived on the device",
    "level": "suspicious",
    "scope": "host"
   }
  ],
  "required_evidence": [
   {
    "any_of": [
     "b_seqlen",
     "B_Seqlen",
     "seqlen"
    ],
    "message": "per-batch valid split count derived from b_seqlen",
    "level": "suspicious"
   },
   {
    "any_of": [
     "exp2",
     "\\bexp\\(",
     "nl\\.exp",
     "T\\.exp"
    ],
    "message": "exponentiation of lse - max",
    "level": "suspicious"
   },
   {
    "any_of": [
     "maximum",
     "tl\\.max",
     "ct\\.max",
     "T\\.reduce_max",
     "nl\\.max",
     "nisa\\.tensor_reduce",
     "\\bmax\\("
    ],
    "message": "running or global max over splits",
    "level": "suspicious"
   },
   {
    "any_of": [
     "float32",
     "fp32",
     "astype"
    ],
    "message": "fp32 accumulation",
    "level": "suspicious"
   },
   {
    "any_of": [
     "\\.item\\(\\)",
     "block_seq"
    ],
    "message": "block_seq scalar consumed",
    "level": "suspicious"
   }
  ],
  "allowed_torch_calls": [
   "torch.empty",
   "torch.cuda.current_stream"
  ],
  "mutation": {
   "inputs_mutated": [],
   "restore_required": false
  },
  "outputs": {
   "structure": "tensor",
   "count": 1,
   "aliasing": "none; a freshly allocated (batch, heads, head_dim) tensor in mid_o.dtype on every call"
  },
  "timing_boundary": {
   "includes_preprocessing": false,
   "notes": "Measured: GPU time of all device work run() causes (the combine kernel); the host .item() on the CPU block_seq scalar, the output allocation call and the metadata-only view are host work, not GPU time. No clone/masking of mid_o_lse, no copies, no state across calls. bytes_expr counts the mid_o read only (small undercount of lse/b_seqlen/output traffic)."
  },
  "tolerance_source": "config.verify"
 },
