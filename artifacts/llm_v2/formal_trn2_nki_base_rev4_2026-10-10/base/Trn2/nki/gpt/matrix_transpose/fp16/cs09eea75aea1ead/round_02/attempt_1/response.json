       "parsed": null,
       "text": "```python title=\"impl_nki.py\"\nimport torch\nimport nki\nimport nki.language as nl\nimport nki.isa as nisa\n\n\n_LAST_CONFIG = {}\n\n\n@nki.jit\ndef _matrix_transpose(x, tile_m, tile_n):\n    m, n = x.shape\n    out = nl.ndarray((n, m), dtype=x.dtype, buffer=nl.shared_hbm)\n\n    pid = nl.program_id(0)\n    programs = nl.num_programs()\n    rows_per_program = m // programs\n\n    row_lanes = 16\n    column_lanes = 128\n    row_groups = tile_m // row_lanes\n    column_groups = tile_n // column_lanes\n\n    assert m % programs == 0\n    assert rows_per_program % tile_m == 0\n    assert n % tile_n == 0\n\n    def column_body(column_start):\n        for block in range(rows_per_program // tile_m):\n            row_start = pid * rows_per_program + block * tile_m\n\n            # indirect_dim refers to the original HBM tensor's axes:\n            # x axis 1 has stride 1, so column_start is an element offset.\n            source = x.ap(\n                pattern=[\n                    [n, row_lanes],\n                    [column_lanes, column_groups],\n                    [row_lanes * n, row_groups],\n                    [1, column_lanes],\n                ],\n                offset=row_start * n,\n                scalar_offset=column_start,\n                indirect_dim=1,\n            )\n\n            transposed = nl.ndarray(\n                (column_lanes, column_groups, row_groups, row_lanes),\n                dtype=x.dtype,\n                buffer=nl.sbuf,\n            )\n            nisa.dma_transpose(\n                dst=transposed,\n                src=source,\n                axes=(3, 1, 2, 0),\n                dge_mode=nisa.dge_mode.hwdge,\n            )\n\n            # out axis 0 has stride m, placing this column tile at\n            # output row column_start.\n            destination = out.ap(\n                pattern=[\n                    [m, column_lanes],\n                    [column_lanes * m, column_groups],\n                    [1, tile_m],\n                ],\n                offset=row_start,\n                scalar_offset=column_start,\n                indirect_dim=0,\n            )\n            nisa.dma_copy(\n                dst=destination,\n                src=transposed.reshape(\n                    (column_lanes, column_groups, tile_m)\n                ),\n            )\n\n    nl.fori_loop(0, n, column_body, step=tile_n)\n    return out\n\n\ndef run(x: torch.Tensor):\n    global _LAST_CONFIG\n\n    m, n = x.shape\n    tile_m = 1024\n    tile_n = 1024\n\n    _LAST_CONFIG = {\n        \"tile_m\": tile_m,\n        \"tile_n\": tile_n,\n        \"row_lanes\": 16,\n        \"column_lanes\": 128,\n        \"transpose\": \"dma_hwdge_4d\",\n        \"lnc\": 2,\n        \"split_axis\": \"input_rows\",\n        \"row_tiles_per_core\": m // (2 * tile_m),\n        \"column_tiles\": n // tile_n,\n        \"loop\": \"fori_columns\",\n    }\n\n    return _matrix_transpose[2](x, tile_m, tile_n)\n\n\ndef get_last_config() -> dict:\n    return dict(_LAST_CONFIG)\n```",
