 "rules": {
  "schema": "tilebench-evaluator-rules/1",
  "operator": "1d_conv",
  "contract_revision": 2,
  "required_stages": [
   {
    "id": "allocate_output",
    "description": "Allocate a fresh (batch, out_channels, out_L) output of input's dtype inside run(); no zero-fill needed."
   },
   {
    "id": "implicit_gemm_conv",
    "description": "One logical pass with no global-memory intermediate (no im2col, padded copy or split-K partials; the output tiles may be spread over several launches): per group, output viewed as (batch*out_L) x Cout_g, reduction over the flattened (ic_local, kl) axis gathered on the fly with zero fill, tensor-core product into a local fp32 accumulator, cast and masked/clipped store."
   }
  ],
  "forbidden_substitutions": [
   {
    "pattern": "torch\\.(nn\\.functional\\.)?conv[123]d\\(|\\bF\\.conv[123]d\\(|torch\\.nn\\.Conv[123]d",
    "message": "A library convolution replaces the whole computation.",
    "level": "confirmed",
    "scope": "host"
   },
   {
    "pattern": "torch\\.(matmul|bmm|mm|einsum|baddbmm|addmm)\\(",
    "message": "A library GEMM (on an im2col matrix or otherwise) replaces the core computation.",
    "level": "confirmed",
    "scope": "host"
   },
   {
    "pattern": "\\.unfold\\(|torch\\.(nn\\.functional\\.)?unfold\\(|\\bF\\.unfold\\(|im2col",
    "message": "Materialised im2col/unfold is forbidden; the convolution must be an implicit GEMM.",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "torch\\.(nn\\.functional\\.)?pad\\(|\\bF\\.pad\\(|torch\\.zeros\\(|torch\\.zeros_like\\(|torch\\.full\\(",
    "message": "A padded or zero-filled copy of the input is forbidden; zero padding must be realised by masking inside the kernel.",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "atomic_add|tl\\.atomic|ct\\.atomic|T\\.atomic|nl\\.atomic",
    "message": "Atomic accumulation suggests split-K, which is a different reduction structure.",
    "level": "suspicious",
    "scope": "any"
   },
   {
    "pattern": "\\.half\\(\\)|\\.bfloat16\\(\\)|\\.to\\(torch\\.(float16|bfloat16)\\)|astype\\([^)]*(float16|bfloat16)",
    "message": "Possible downcast of fp32 operands below TF32 precision.",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "WeakTensorKeyDictionary|lru_cache|functools\\.cache|_cache\\b",
    "message": "Cross-call caching of input-derived data is forbidden.",
    "level": "suspicious",
    "scope": "host"
   }
  ],
  "required_evidence": [
   {
    "any_of": [
     "tl\\.dot",
     "ct\\.mma",
     "T\\.gemm",
     "nisa\\.nc_matmul",
     "nl\\.matmul",
     "nki\\.isa\\.nc_matmul"
    ],
    "message": "No matrix-multiply primitive found; the implicit GEMM must use a tensor-core product.",
    "level": "suspicious"
   },
   {
    "any_of": [
     "float32",
     "fp32",
     "f32"
    ],
    "message": "No fp32 accumulator evidence found.",
    "level": "suspicious"
   }
  ],
  "allowed_torch_calls": [
   "torch.empty",
   "torch.cuda.current_stream",
   "Tensor.view",
   "Tensor.reshape",
   "Tensor.stride",
   "Tensor.is_contiguous"
  ],
