 "rules": {
  "schema": "tilebench-evaluator-rules/1",
  "operator": "batched_matmul",
  "contract_revision": 2,
  "required_stages": [
   {
    "id": "allocate_output",
    "description": "Allocate a fresh flat (BATCH*M*N,) (or (BATCH, M, N)) output of A's dtype inside run()."
   },
   {
    "id": "batched_gemm",
    "description": "One logical pass with no partial-sum intermediate in global memory (no split-K partials; the output tiles may be spread over several launches): each (batch, M-tile, N-tile) output tile accumulates the full K range sequentially into a local fp32 accumulator via a tensor-core product, with zero-filled edge loads and clipped/masked stores; cast to A's dtype at the store. An optional per-call, in-run repack/transpose of an operand in its own dtype (device work, counted) may precede it; a cross-call cache of such a copy may not."
   }
  ],
  "forbidden_substitutions": [
   {
    "pattern": "torch\\.(matmul|bmm|mm|einsum|baddbmm|addmm|addbmm)\\(|torch\\.linalg\\.matmul",
    "message": "A library GEMM replaces the whole computation.",
    "level": "confirmed",
    "scope": "host"
   },
   {
    "pattern": "\\w[ \\t]*@[ \\t]*\\w",
    "message": "The @ operator on tensors is a library GEMM.",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "\\.transpose\\(|\\.permute\\(|\\.t\\(\\)|\\.contiguous\\(\\)",
    "message": "Host-side transpose/repack or copy of an operand: permitted only as device work inside every run() (its time counted) in the operand's own dtype, never cached across calls; in-kernel tile transposes are fine.",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "WeakTensorKeyDictionary|lru_cache|functools\\.cache|data_ptr\\(\\)\\s*(in|not in|==)|_cache\\b|\\bcache\\b|cache\\[",
    "message": "Possible cross-call cache keyed by input identity/data pointer; transformed operands must be rebuilt inside every run().",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "atomic_add|tl\\.atomic|ct\\.atomic|T\\.atomic|nl\\.atomic",
    "message": "Atomic accumulation suggests split-K, which is a different reduction structure.",
    "level": "suspicious",
    "scope": "any"
   },
   {
    "pattern": "\\.half\\(\\)|\\.bfloat16\\(\\)|\\.to\\(torch\\.(float16|bfloat16)\\)|astype\\([^)]*(float16|bfloat16)",
    "message": "Possible downcast of fp32 operands below TF32 precision.",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "torch\\.zeros\\(|torch\\.zeros_like\\(|torch\\.full\\(",
    "message": "No zero-filled scratch is part of this operator; only an uninitialised output is expected.",
    "level": "suspicious",
    "scope": "host"
   }
  ],
  "required_evidence": [
   {
    "any_of": [
     "tl\\.dot",
     "ct\\.mma",
     "T\\.gemm",
     "nisa\\.nc_matmul",
     "nl\\.matmul",
     "nki\\.isa\\.nc_matmul"
    ],
    "message": "No matrix-multiply primitive found; the GEMM must use a tensor-core product.",
    "level": "suspicious"
   },
   {
    "any_of": [
     "float32",
     "fp32",
     "f32"
    ],
    "message": "No fp32 accumulator evidence found.",
    "level": "suspicious"
   }
  ],
  "allowed_torch_calls": [
   "torch.empty",
   "torch.cuda.current_stream",
   "Tensor.view",
   "Tensor.reshape",
   "Tensor.stride",
   "Tensor.transpose",
   "Tensor.permute",
   "Tensor.t",
   "Tensor.contiguous"
  ],
  "mutation": {
   "inputs_mutated": [],
   "restore_required": false
  },
  "outputs": {
   "structure": "tensor",
   "count": 1,
   "aliasing": "none; the returned flat (BATCH*M*N,) tensor (or flat view of a fresh (BATCH, M, N) buffer) must be allocated inside run() and must not share storage with A or B"
  },
  "timing_boundary": {
   "includes_preprocessing": true,
   "notes": "The GPU time of all device work launched by run() on every call is counted: the GEMM launch(es) and, if the design uses one, the per-call repack/transpose copy of an operand. Zero-copy views, host descriptor/metadata construction and the output allocation call are host-side work and not GPU time. Decided rule: B (and A) are delivered row-major and may be consumed directly or through a repacked/transposed copy rebuilt by device work inside every run(); cross-call caches of a transformed operand, descriptor or output keyed on input identity, data pointer, shape or values are forbidden; no prepacked inputs may be assumed. The metric formulas count one read of A, one read of B and one write of C only; the repack's traffic is diagnostic."
  },
