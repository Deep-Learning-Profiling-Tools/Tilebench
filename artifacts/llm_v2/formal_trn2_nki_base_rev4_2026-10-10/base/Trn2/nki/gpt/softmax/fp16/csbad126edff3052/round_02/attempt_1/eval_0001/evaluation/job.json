 "rules": {
  "schema": "tilebench-evaluator-rules/1",
  "operator": "softmax",
  "contract_revision": 2,
  "required_stages": [
   {
    "id": "allocate_output",
    "description": "Allocate a fresh (n_rows, n_cols) output of x's dtype inside run()."
   },
   {
    "id": "online_row_statistics",
    "description": "Per row, the exact fp32 row max m and fp32 denominator l: either via the online rescaling recurrence over chunks (the running max is subtracted inside the recurrence) or directly over a row held on chip; held privately by the program that owns the row, never passed through global memory."
   },
   {
    "id": "normalise",
    "description": "Per element, exp(x - m) / l with the final row statistics, in fp32, with one downcast at the store."
   }
  ],
  "forbidden_substitutions": [
   {
    "pattern": "torch\\.softmax\\(|torch\\.nn\\.functional\\.softmax\\(|F\\.softmax\\(|torch\\.log_softmax\\(|F\\.log_softmax\\(|nn\\.Softmax\\(|nn\\.LogSoftmax\\(|torch\\.special\\.softmax\\(",
    "message": "The whole operator is performed by a PyTorch softmax routine.",
    "level": "confirmed",
    "scope": "host"
   },
   {
    "pattern": "(?<!tl)(?<!ct)(?<!nl)\\.softmax\\(|nl\\.softmax\\(",
    "message": "A tensor-method or library softmax replaces the online two-sweep kernel.",
    "level": "suspicious",
    "scope": "any"
   },
   {
    "pattern": "torch\\.(max|amax|sum|exp|logsumexp|exp2)\\(|torch\\.special\\.logsumexp\\(",
    "message": "Host-side PyTorch reduction or exponential computes the row statistics outside the kernel.",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "\\.(amax|max|sum|logsumexp)\\(\\s*(dim\\s*=\\s*)?-?1\\b|\\.exp\\(\\s*\\)",
    "message": "Tensor-method statistics on the host replace the in-kernel reduction.",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "atomic_max|atomic_add|atomic",
    "message": "Atomics suggest a cross-program row reduction, which the contract forbids.",
    "level": "suspicious",
    "scope": "any"
   },
   {
    "pattern": "\\.(to|astype)\\(\\s*(tl|ct|T|nl)?\\.?(float16|bfloat16|half|bf16|fp16)\\b[^\\n]*exp\\(",
    "message": "Exponentials appear to be evaluated in half precision; they must be fp32.",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "return\\s+x\\b|return\\s+x\\.|x\\.copy_\\(|x\\.sub_\\(|x\\.exp_\\(|x\\.div_\\(|x\\[.*\\]\\s*=",
    "message": "Writing into or returning the input violates the fresh-output / no-mutation rules.",
    "level": "suspicious",
    "scope": "host"
   }
  ],
  "required_evidence": [
   {
    "any_of": [
     "tl\\.max",
     "ct\\.max",
     "T\\.reduce_max",
     "nl\\.max",
     "nisa\\.tensor_reduce",
     "reduce_max",
     "max"
    ],
    "message": "No in-kernel max reduction found for the row maximum.",
    "level": "suspicious"
   },
   {
    "any_of": [
     "tl\\.sum",
     "ct\\.sum",
     "T\\.reduce_sum",
     "nl\\.sum",
     "nisa\\.tensor_reduce",
     "reduce_sum",
     "sum"
    ],
    "message": "No in-kernel sum reduction found for the denominator.",
    "level": "suspicious"
   },
   {
    "any_of": [
     "tl\\.exp",
     "tl\\.exp2",
     "ct\\.exp",
     "ct\\.exp2",
     "T\\.exp",
     "T\\.exp2",
