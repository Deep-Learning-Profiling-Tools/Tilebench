 "tolerance_source": "config.verify+dtype_default",
 "rules": {
  "schema": "tilebench-evaluator-rules/1",
  "operator": "weight_dequant",
  "contract_revision": 2,
  "required_stages": [
   {
    "id": "allocate_output",
    "description": "Allocate a fresh (M, N) output of X's dtype inside run()."
   },
   {
    "id": "block_scaled_multiply",
    "description": "One logical pass over all M*N elements (the number of launches is a mapping choice): derive the block coordinates (i // T, j // T) of each element, fetch the scale from S (per-element gather or per-tile hoisted load), multiply X by it, store (masked wherever the fixed shape is not a multiple of the chosen tile). No expanded scale map in global memory."
   }
  ],
  "forbidden_substitutions": [
   {
    "pattern": "S\\[[^\\]]*\\[:,\\s*None\\][^\\]]*\\]|S\\[[^\\]]*None,\\s*:\\][^\\]]*\\]|torch\\.repeat_interleave\\(|\\.repeat_interleave\\(|torch\\.kron\\(|\\.expand\\(|torch\\.tile\\(|\\.repeat\\(",
    "message": "The expanded (M, N) scale map is materialised with PyTorch, reproducing the reference on the host.",
    "level": "confirmed",
    "scope": "host"
   },
   {
    "pattern": "torch\\.arange\\([^)]*\\)\\s*//|torch\\.div\\(|torch\\.floor_divide\\(",
    "message": "Host-side index construction for the scale map (reference-style).",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "torch\\.mul\\(|torch\\.multiply\\(|return\\s+X\\s*\\*|output\\s*=\\s*X\\s*\\*|\\.copy_\\(\\s*X\\s*\\*",
    "message": "The multiply is performed by PyTorch on the host instead of the kernel.",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "return\\s+(X|S)\\b|return\\s+(X|S)\\.|\\b(X|S)\\.copy_\\(|\\b(X|S)\\.mul_\\(|\\b(X|S)\\[.*\\]\\s*=",
    "message": "Writing into or returning an input violates the fresh-output / no-mutation rules.",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "torch\\.round\\(|\\.round\\(\\)|torch\\.ceil\\(|/\\s*TILE_SIZE\\b(?!\\s*\\))",
    "message": "Scale indexing must use floor division of the row and column by the block side.",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "\\.cpu\\(\\)|\\.numpy\\(\\)|\\.tolist\\(\\)",
    "message": "Host round-trip of the data.",
    "level": "suspicious",
    "scope": "host"
   }
  ],
  "required_evidence": [
   {
    "any_of": [
     "tl\\.store",
     "ct\\.store",
     "store_offset",
     "T\\.copy",
     "nl\\.store",
     "nisa\\.dma_copy"
    ],
    "message": "No kernel-level store found; the multiply must be done by a kernel.",
    "level": "suspicious"
   },
   {
    "any_of": [
     "//\\s*TILE_SIZE",
     "//\\s*T\\b",
     "//\\s*tile_size",
     "//\\s*BLOCK_SCALE",
     "// "
    ],
    "message": "No floor-division block-index evidence for the scale lookup.",
    "level": "suspicious"
   },
   {
    "any_of": [
     "ct\\.gather",
     "tl\\.load",
     "T\\.copy",
     "nl\\.load",
     "nisa\\.dma_copy",
     "gather"
    ],
    "message": "No in-kernel scale load/gather found.",
    "level": "suspicious"
   }
  ],
  "allowed_torch_calls": [
   "torch.empty",
   "torch.cuda.current_stream",
   "Tensor.contiguous",
   "Tensor.view",
   "Tensor.reshape",
   "Tensor.numel",
   "Tensor.stride"
  ],
  "mutation": {
   "inputs_mutated": [],
   "restore_required": false
  },
  "outputs": {
   "structure": "tensor",
   "count": 1,
   "aliasing": "none; the returned (M, N) tensor must be freshly allocated inside run() with X's dtype and must not share storage with X or S"
  },
  "timing_boundary": {
   "includes_preprocessing": true,
   "notes": "All device work launched by run() is counted (the elementwise kernel launch(es)); host-side work (the output allocation call, flat/2-D views, metadata reads) is not GPU time. No cached state, no copy or cast of X or S, no materialised expanded scale map, no second pass."
  },
  "tolerance_source": "config.verify"
 },
