 "rules": {
  "schema": "tilebench-evaluator-rules/1",
  "operator": "rmsnorm",
  "contract_revision": 2,
  "required_stages": [
   {
    "id": "allocate_output",
    "description": "Allocate a fresh output of x's shape and dtype inside run(); never write into x."
   },
   {
    "id": "row_sum_squares",
    "description": "Per row, an fp32 sum of squares over the last dimension K (chunked loop or whole-row tile), divided by the true K, plus eps, then reciprocal square root: one rstd per row, held on chip in a fused design or written to a per-call fp32 (batch*M,) statistics buffer in a split design."
   },
   {
    "id": "normalise_scale",
    "description": "Per element, x * rstd * w evaluated in fp32 with one downcast to the output dtype at the store, using the row's rstd (held on chip in a fused design, or read from the per-call statistics buffer in a split design; fused versus split launches is a mapping choice, and the row is never traversed a third time)."
   }
  ],
  "forbidden_substitutions": [
   {
    "pattern": "torch\\.nn\\.functional\\.rms_norm\\(|F\\.rms_norm\\(|torch\\.rms_norm\\(|nn\\.RMSNorm\\(",
    "message": "The whole operator is performed by a PyTorch normalisation routine.",
    "level": "confirmed",
    "scope": "host"
   },
   {
    "pattern": "torch\\.nn\\.functional\\.layer_norm\\(|F\\.layer_norm\\(|torch\\.layer_norm\\(|nn\\.LayerNorm\\(",
    "message": "A library normalisation routine replaces the kernel.",
    "level": "confirmed",
    "scope": "host"
   },
   {
    "pattern": "torch\\.(rsqrt|mean|sum|square|var|norm)\\(",
    "message": "Host-side PyTorch reduction or rsqrt computes the row statistic outside the kernel.",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "\\.(pow|square|rsqrt|mean|var)\\(\\s*(2\\s*)?\\)|\\.pow\\(\\s*2\\s*\\)|\\.mean\\(\\s*-?1|\\.sum\\(\\s*-?1|\\.mean\\(\\s*dim|\\.sum\\(\\s*dim",
    "message": "Tensor-method statistics on the host (pow/mean/sum/rsqrt over the last dim) replace the in-kernel reduction.",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "\\.(to|astype)\\(\\s*(tl|ct|T|nl)?\\.?(float16|bfloat16|half|bf16|fp16)\\b",
    "message": "Downcast before the store: the sum of squares and the normalise multiply must stay in fp32 until the single final cast.",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "atomic_add|atomic_max|atomic",
    "message": "Atomics suggest a cross-program row reduction, which the contract forbids.",
    "level": "suspicious",
    "scope": "any"
   },
   {
    "pattern": "return\\s+x\\b|return\\s+x\\.|x\\[.*\\]\\s*=|x\\.copy_\\(|x\\.mul_\\(",
    "message": "Writing into or returning the input violates the fresh-output / no-mutation rules.",
    "level": "suspicious",
    "scope": "host"
   }
  ],
  "required_evidence": [
   {
    "any_of": [
     "tl\\.sum",
     "ct\\.sum",
     "T\\.reduce_sum",
     "nl\\.sum",
     "nisa\\.tensor_reduce",
     "reduce"
    ],
    "message": "No in-kernel reduction primitive found for the row sum of squares.",
    "level": "suspicious"
   },
   {
    "any_of": [
     "rsqrt",
     "sqrt"
    ],
    "message": "No reciprocal-square-root evidence for rstd.",
    "level": "suspicious"
   },
   {
    "any_of": [
     "float32",
     "fp32",
     "f32"
    ],
    "message": "No fp32 upcast evidence; the statistic and multiply must be fp32.",
    "level": "suspicious"
   },
   {
    "any_of": [
     "eps"
    ],
    "message": "eps does not appear; it must be added inside the square root.",
    "level": "suspicious"
   }
  ],
  "allowed_torch_calls": [
   "torch.empty_like",
   "torch.empty",
   "torch.cuda.current_stream",
   "Tensor.reshape",
   "Tensor.view",
   "Tensor.contiguous",
   "Tensor.stride",
   "Tensor.numel"
  ],
  "mutation": {
   "inputs_mutated": [],
   "restore_required": false
  },
  "outputs": {
   "structure": "tensor",
   "count": 1,
   "aliasing": "none; the returned (batch, M, K) tensor must be freshly allocated inside run() and must not share storage with x or rms_w"
  },
  "timing_boundary": {
   "includes_preprocessing": true,
   "notes": "All device work launched by run() is counted (the normalisation kernel launch(es)); host-side work (the (batch*M, K) views, the output allocation call, metadata reads) is not GPU time. No cached state across calls, no repack or cast of x or rms_w; a per-call statistics buffer of a split design is device work and is counted; it is never cached across calls. eps is always the default 1e-6 in the benchmark."
  },
  "tolerance_source": "config.verify"
 },
