 "rules": {
  "schema": "tilebench-evaluator-rules/1",
  "operator": "moe_topk_gating",
  "contract_revision": 2,
  "required_stages": [
   {
    "id": "allocate_outputs",
    "description": "Allocate weights (M, k) in logits.dtype and indices (M, k) int32 inside run()."
   },
   {
    "id": "row_load_fp32",
    "description": "One logical traversal of each row of logits, upcast to float32 and kept on chip across the rounds; positions beyond E padded with -inf."
   },
   {
    "id": "iterative_argmax_selection",
    "description": "k sequential rounds of full-row max + argmax; record value and int32 index into slot i; exclude the chosen column with -inf; output order is descending."
   },
   {
    "id": "softmax_over_k",
    "description": "Numerically stable float32 softmax (max-subtract, exp, sum, divide) over only the k selected values; padded slots contribute 0."
   },
   {
    "id": "store_outputs",
    "description": "Store weights cast to logits.dtype and int32 indices; fused with the previous stages, with nothing written to global memory between them."
   }
  ],
  "forbidden_substitutions": [
   {
    "pattern": "torch\\.topk\\(|\\.topk\\(",
    "message": "torch.topk replaces the whole selection stage.",
    "level": "confirmed",
    "scope": "host"
   },
   {
    "pattern": "torch\\.sort\\(|torch\\.argsort\\(|torch\\.kthvalue\\(|torch\\.msort\\(|(?<!tl)(?<!ct)(?<!nl)\\.sort\\(|\\.argsort\\(",
    "message": "Host-side sort/argsort replaces the selection stage.",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "torch\\.softmax\\(|torch\\.nn\\.functional\\.softmax\\(|F\\.softmax\\(|\\.softmax\\(|torch\\.exp\\(|torch\\.logsumexp",
    "message": "Host-side softmax/exp replaces the normalisation stage.",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "torch\\.max\\(|torch\\.argmax\\(|torch\\.amax\\(|torch\\.gather\\(|torch\\.index_select\\(|torch\\.take_along_dim",
    "message": "Host-side max/argmax/gather assembles the outputs with PyTorch.",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "\\.float\\(\\)|\\.to\\(\\s*torch\\.float32|\\.half\\(\\)|\\.to\\(\\s*torch\\.(float16|bfloat16)",
    "message": "Host-side dtype conversion of logits or of the outputs is an extra pass; conversions belong inside the kernel.",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "torch\\.zeros|torch\\.full\\(|torch\\.ones",
    "message": "No initialised global scratch is part of this operator.",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "\\.clone\\(\\)|\\.copy_\\(|\\.contiguous\\(\\)",
    "message": "A host-side copy of logits inside run() is not permitted.",
    "level": "suspicious",
    "scope": "host"
   }
  ],
