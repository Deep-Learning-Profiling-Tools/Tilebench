 "rules": {
  "schema": "tilebench-evaluator-rules/1",
  "operator": "dequantize_rowwise",
  "contract_revision": 2,
  "required_stages": [
   {
    "id": "s1",
    "description": "Element-wise: int8 x converted to fp32, multiplied by the fp32 row scale and by the fp32 constant 1/127."
   },
   {
    "id": "s2",
    "description": "Single rounding from fp32 to fp16 at the store into a freshly allocated (rows, cols) fp16 output, fused with s1 per element: no global intermediate and no second pass (the number of launches is a mapping choice)."
   }
  ],
  "forbidden_substitutions": [
   {
    "pattern": "torch\\.dequantize|torch\\._make_per_channel_quantized_tensor|torch\\._make_per_tensor_quantized_tensor|torch\\.ops\\.quantized|torch\\.ao\\.",
    "message": "library dequantisation replaces the whole computation",
    "level": "confirmed",
    "scope": "host"
   },
   {
    "pattern": "torch\\.(mul|multiply|div|divide|true_divide)\\(",
    "message": "host-side tensor arithmetic performs the dequantisation",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "state_x\\.unsqueeze|state_x\\[:,\\s*None\\]|\\.unsqueeze\\(1\\)\\s*\\*",
    "message": "host-side broadcast multiply of the row scale",
    "level": "suspicious",
    "scope": "any"
   },
   {
    "pattern": "x\\.(float|half|to)\\(|x\\.to\\(torch",
    "message": "host-side cast of the int8 input (pre-cast copy is forbidden)",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "torch\\.(zeros|zeros_like|full|empty_like)\\(",
    "message": "extra buffer; no intermediate is permitted (only the fp16 output via torch.empty)",
    "level": "suspicious",
    "scope": "host"
   }
  ],
  "required_evidence": [
   {
    "any_of": [
     "127"
    ],
    "message": "the 1/127 dequantisation constant",
    "level": "suspicious"
   },
   {
    "any_of": [
     "float32",
     "fp32",
     "\\.to\\(tl\\.float32\\)",
     "astype"
    ],
    "message": "fp32 conversion before the multiplies",
    "level": "suspicious"
   },
   {
    "any_of": [
     "float16",
     "fp16",
     "half"
    ],
    "message": "fp16 rounding at the store",
    "level": "suspicious"
   }
  ],
  "allowed_torch_calls": [
   "torch.empty",
   "torch.cuda.current_stream"
  ],
  "mutation": {
   "inputs_mutated": [],
   "restore_required": false
  },
  "outputs": {
   "structure": "tensor",
   "count": 1,
   "aliasing": "none; a freshly allocated (rows, cols) fp16 tensor on every call"
  },
  "timing_boundary": {
   "includes_preprocessing": false,
