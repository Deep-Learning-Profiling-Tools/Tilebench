  "schema": "tilebench-evaluator-rules/1",
  "operator": "linear_self_attention",
  "contract_revision": 2,
  "required_stages": [
   {
    "id": "phi_q",
    "description": "PHI_Q = where(Q > 0, Q + 1, exp(Q)) in fp32 (materialised or fused into the output stage)."
   },
   {
    "id": "phi_k",
    "description": "PHI_K = where(K > 0, K + 1, exp(K)) in fp32 (materialised or fused into the state/normaliser loads)."
   },
   {
    "id": "state_s",
    "description": "S = PHI_K^T @ V, (D, D), reduced over all M rows, TF32-or-better operands, fp32 accumulation."
   },
   {
    "id": "colsum_z",
    "description": "Z = column sums of PHI_K over M, (D,), fp32 (separate pass or fused into state_s)."
   },
   {
    "id": "output_o",
    "description": "O = (PHI_Q @ S) / (PHI_Q . Z + eps); numerator TF32-or-better/fp32-acc, denominator full fp32, eps added once after the reduction."
   }
  ],
