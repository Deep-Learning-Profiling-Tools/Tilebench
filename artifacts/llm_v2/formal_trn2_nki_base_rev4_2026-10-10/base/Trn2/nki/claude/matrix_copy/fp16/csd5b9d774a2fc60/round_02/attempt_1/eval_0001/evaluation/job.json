 "rules": {
  "schema": "tilebench-evaluator-rules/1",
  "operator": "matrix_copy",
  "contract_revision": 2,
  "required_stages": [
   {
    "id": "allocate_output",
    "description": "Allocate a fresh (N, N) output of A's dtype inside run()."
   },
   {
    "id": "stream_copy",
    "description": "One logical pass (any split across programs or launches, no global intermediate) that reads every element of A once and writes it unchanged to the same position of the output, with edge handling wherever the fixed N*N (or N, for 2-D tiles) is not a multiple of the chosen tile."
   }
  ],
  "forbidden_substitutions": [
   {
    "pattern": "torch\\.clone\\(|\\.clone\\(\\)|\\.copy_\\(|torch\\.Tensor\\.to\\(|copy\\s*=\\s*True",
    "message": "The copy must be performed by the kernel, not by a PyTorch clone/copy.",
    "level": "confirmed",
    "scope": "host"
   },
   {
    "pattern": "return\\s+A\\b|return\\s+A\\.view|return\\s+A\\.reshape|return\\s+A\\.contiguous",
    "message": "Returning the input or a view of it violates the fresh-output requirement.",
    "level": "confirmed",
    "scope": "host"
   },
   {
    "pattern": "\\bA\\s*\\+\\s*0\\b|\\bA\\s*\\*\\s*1\\b|torch\\.add\\(|torch\\.mul\\(",
    "message": "Host-side arithmetic identity on the input replaces the whole computation.",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "\\.to\\(\\s*torch\\.|\\.float\\(\\)|\\.half\\(\\)|\\.bfloat16\\(\\)|\\.int\\(\\)",
    "message": "No dtype conversion is allowed anywhere in matrix_copy.",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "torch\\.zeros|torch\\.ones|torch\\.full\\(",
    "message": "No initialised scratch buffer is part of this operator; only torch.empty / torch.empty_like are expected.",
    "level": "suspicious",
    "scope": "host"
   }
  ],
  "required_evidence": [
   {
    "any_of": [
     "tl\\.store",
     "ct\\.store",
     "store_offset",
     "T\\.copy",
     "nl\\.store",
     "nisa\\.dma_copy"
    ],
    "message": "No kernel-level store found; the copy must be done by a kernel.",
    "level": "suspicious"
   },
   {
    "any_of": [
     "tl\\.load",
     "ct\\.load",
     "load_offset",
     "get_raw_memory",
     "T\\.copy",
     "nl\\.load",
     "nisa\\.dma_copy"
    ],
    "message": "No kernel-level load found.",
    "level": "suspicious"
   }
  ],
  "allowed_torch_calls": [
   "torch.empty",
   "torch.empty_like",
   "torch.cuda.current_stream",
   "Tensor.view",
   "Tensor.reshape",
   "Tensor.contiguous",
   "Tensor.numel",
