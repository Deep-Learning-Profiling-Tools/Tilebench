 "rules": {
  "schema": "tilebench-evaluator-rules/1",
  "operator": "rope",
  "contract_revision": 2,
  "required_stages": [
   {
    "id": "fresh_output",
    "description": "Obtain a non-aliasing output buffer of q's shape and dtype inside run(): an empty allocation (out-of-place) or a clone of q (in-place scheme)."
   },
   {
    "id": "table_fetch",
    "description": "Per (batch, position) row, read the cos and sin rows of the sequence position (row index modulo S), shared across heads."
   },
   {
    "id": "pairwise_rotation",
    "description": "One logical elementwise stage (the number of launches is a mapping choice): for every head and i < D/2 read (q[i], q[i+D/2]) and write q1*cos - q2*sin to the first half and q2*cos + q1*sin to the second half of the output."
   }
  ],
  "forbidden_substitutions": [
   {
    "pattern": "torch\\.cat\\(|torch\\.concat\\(|torch\\.concatenate\\(",
    "message": "Host-side concatenation of the two halves reproduces the reference formulation outside the kernel.",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "\\.unsqueeze\\(|torch\\.unsqueeze\\(|\\[None, :|\\[:, None, :\\]",
    "message": "Host-side broadcasting of the tables; combined with slicing arithmetic this performs the rotation in PyTorch.",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "torch\\.(cos|sin|polar|outer|view_as_complex|view_as_real|complex)\\(|torch\\.arange\\([^)]*\\)\\s*\\*",
    "message": "Regenerating the rotary tables or using a complex-number formulation; the tables are inputs and must be consumed as given.",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "apply_rotary|rotary_emb|rotate_half|flash_attn|liger",
    "message": "A library or reference-style rotary routine replaces the kernel.",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "q\\[\\.\\.\\.,\\s*:|q\\[\\.\\.\\.,\\s*\\w+\\s*//\\s*2|q1\\s*\\*\\s*cos|q2\\s*\\*\\s*sin",
    "message": "Reference-style half slicing and tensor arithmetic on the host.",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "return\\s+q\\b|return\\s+q\\.|q\\.copy_\\(|q\\.mul_\\(|q\\.add_\\(|q\\.sub_\\(",
    "message": "Mutating or returning the input q violates the no-mutation / fresh-output rules.",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "\\b(2\\s*\\*\\s*i|\\[::2\\]|\\[1::2\\]|interleav)",
    "message": "Interleaved (even/odd) pairing is a different operator; pairing must be i with i + D/2.",
    "level": "suspicious",
    "scope": "host"
   }
  ],
  "required_evidence": [
   {
    "any_of": [
     "tl\\.store",
     "ct\\.store",
     "store_offset",
     "T\\.copy",
     "nl\\.store",
     "nisa\\.dma_copy"
    ],
    "message": "No kernel-level store found; the rotation must be done by a kernel.",
    "level": "suspicious"
   },
   {
    "any_of": [
     "//\\s*2",
     "half",
     "HALF",
     "D/2",
     "D // 2"
    ],
    "message": "No evidence of half-split addressing (element i paired with i + D/2).",
    "level": "suspicious"
   },
   {
    "any_of": [
     "%\\s*S\\b",
     "%\\s*seq",
     "% SeqLen",
     "%\\s*seqlen",
     "%\\s*seq_len"
    ],
    "message": "No evidence that the table row is selected by the sequence position (row modulo S).",
    "level": "suspicious"
   }
  ],
  "allowed_torch_calls": [
   "torch.empty_like",
   "torch.empty",
   "torch.cuda.current_stream",
   "Tensor.clone",
   "Tensor.contiguous",
   "Tensor.view",
   "Tensor.reshape",
   "Tensor.stride"
  ],
  "mutation": {
   "inputs_mutated": [],
   "restore_required": false
  },
  "outputs": {
   "structure": "tensor",
   "count": 1,
   "aliasing": "none; the returned (B, S, H, D) tensor must be a buffer created inside run() (empty allocation or clone of q) and must not share storage with q, cos or sin"
  },
  "timing_boundary": {
   "includes_preprocessing": true,
   "notes": "All device work launched by run() is counted, including any clone of q used by an in-place scheme and the rotation kernel launch(es); host-side work (layout views, the output allocation call, metadata reads) is not GPU time. The tables are consumed as given; no cached state across calls, no table transformation or regeneration outside the kernel."
  },
  "tolerance_source": "config.verify"
 },
