 "sandbox_dir": "/home/ubuntu/tb_wt/_llm_trn2/outputs/llm_v2/formal_trn2_nki_base_rev4_2026-10-10/_sandbox/cross_entropy_3_1_ux6g8u8j",
 "atol": 0.001,
 "rtol": 0.001,
 "tolerance_source": "config.verify+dtype_default",
 "rules": {
  "schema": "tilebench-evaluator-rules/1",
  "operator": "cross_entropy",
  "contract_revision": 2,
  "required_stages": [
   {
    "id": "s1",
    "description": "Per-row max over the class axis and sum of exp(logit - max), fp32, from one logical traversal of the row (whole-row tile with non-contributing padding, or chunked online update)."
   },
   {
    "id": "s2",
    "description": "Gather of the target logit logits[i, targets[i]] (re-read or selected from the loaded row)."
   },
   {
    "id": "s3",
    "description": "loss[i] = -(target_logit - max - log(sum)) rounded once to logits.dtype and stored; no global intermediate (statistics, shifted logits, probabilities stay on chip)."
   }
  ],
  "forbidden_substitutions": [
   {
    "pattern": "torch\\.nn\\.functional\\.cross_entropy|F\\.cross_entropy|torch\\.nn\\.CrossEntropyLoss|torch\\.nn\\.NLLLoss|F\\.nll_loss",
    "message": "library cross-entropy replaces the whole computation",
    "level": "confirmed",
    "scope": "host"
   },
   {
    "pattern": "torch\\.(log_softmax|logsumexp|softmax)\\(|F\\.(log_softmax|softmax)\\(|torch\\.special\\.logsumexp",
    "message": "library log-sum-exp/softmax replaces the row reduction",
    "level": "confirmed",
    "scope": "host"
   },
   {
    "pattern": "torch\\.gather\\(|torch\\.take_along_dim|logits\\.gather\\(|logits\\[[^\\]]*targets",
    "message": "host-side gather of the target logit",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "torch\\.(max|amax|sum|exp|log)\\(",
    "message": "host-side reduction or transcendental on tensors",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "torch\\.(zeros|zeros_like|full)\\(",
    "message": "a zero-filled or extra buffer suggests a materialised intermediate; no global scratch is permitted",
    "level": "suspicious",
    "scope": "host"
   }
  ],
  "required_evidence": [
   {
    "any_of": [
     "tl\\.max",
     "ct\\.max",
     "T\\.reduce_max",
     "nl\\.max",
     "nisa\\.tensor_reduce",
     "reduce_max",
     "\\bmax\\("
    ],
    "message": "row max reduction",
    "level": "suspicious"
   },
   {
    "any_of": [
     "tl\\.sum",
     "ct\\.sum",
     "T\\.reduce_sum",
     "nl\\.sum",
     "nisa\\.tensor_reduce",
     "reduce_sum",
     "\\bsum\\("
    ],
    "message": "row sum reduction",
    "level": "suspicious"
   },
   {
    "any_of": [
     "exp2",
     "\\bexp\\(",
     "nl\\.exp",
     "T\\.exp"
    ],
    "message": "exponentiation of shifted logits",
    "level": "suspicious"
   },
   {
    "any_of": [
     "\\blog\\(",
     "log2",
     "nl\\.log",
     "T\\.log"
    ],
    "message": "logarithm of the row sum",
    "level": "suspicious"
   },
   {
    "any_of": [
     "float32",
     "fp32",
     "\\.to\\(tl\\.float32\\)",
     "astype"
    ],
    "message": "fp32 conversion of the row before the reductions",
    "level": "suspicious"
   }
  ],
  "allowed_torch_calls": [
   "torch.empty",
   "torch.cuda.current_stream"
  ],
  "mutation": {
   "inputs_mutated": [],
   "restore_required": false
  },
  "outputs": {
   "structure": "tensor",
   "count": 1,
   "aliasing": "none; a freshly allocated (batch_size,) tensor in logits.dtype on every call"
  },
  "timing_boundary": {
   "includes_preprocessing": false,
   "notes": "Measured: GPU time of all device work run() causes (the loss kernel); the output allocation call and host scalar arithmetic are host work, not GPU time. No casts, copies or transposes are permitted; a .contiguous() on logits must be a no-op. No state across calls."
  },
  "tolerance_source": "config.verify"
 },
