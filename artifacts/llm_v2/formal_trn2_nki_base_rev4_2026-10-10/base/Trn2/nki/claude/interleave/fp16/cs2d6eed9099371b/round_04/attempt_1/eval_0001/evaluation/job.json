 "rules": {
  "schema": "tilebench-evaluator-rules/1",
  "operator": "interleave",
  "contract_revision": 2,
  "required_stages": [
   {
    "id": "output_alloc",
    "description": "Allocate the (2N,) output of A's dtype inside run()."
   },
   {
    "id": "interleave_copy",
    "description": "One logical traversal reading each element of A and B once and writing each element of OUT once with OUT[2i]=A[i], OUT[2i+1]=B[i]; the number of launches is a mapping choice."
   }
  ],
  "forbidden_substitutions": [
   {
    "pattern": "\\[\\s*[01]\\s*::\\s*2\\s*\\]\\s*=",
    "message": "strided slice assignment performs the interleave in PyTorch",
    "level": "confirmed",
    "scope": "host"
   },
   {
    "pattern": "torch\\.repeat_interleave\\(",
    "message": "torch.repeat_interleave computes the interleave",
    "level": "confirmed",
    "scope": "host"
   },
   {
    "pattern": "torch\\.(stack|cat)\\(",
    "message": "torch.stack/torch.cat on the inputs computes the interleave in PyTorch",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "\\.(flatten|view|reshape)\\(\\s*-?1\\s*\\)",
    "message": "flatten/view after a PyTorch stack would be a torch-side interleave",
    "level": "suspicious",
    "scope": "host"
   },
   {
    "pattern": "\\.copy_\\(|torch\\.clone\\(|\\.clone\\(\\)",
    "message": "PyTorch copy of an input or output",
    "level": "suspicious",
    "scope": "host"
   }
  ],
  "required_evidence": [
   {
    "any_of": [
     "tl\\.store",
     "ct\\.store",
     "store_offset",
     "T\\.copy",
     "nl\\.store",
     "nisa\\."
    ],
    "message": "a device-side store of the interleaved tile",
    "level": "suspicious"
   },
   {
    "any_of": [
     "@triton\\.jit",
     "@ct\\.kernel",
     "@tilelang\\.jit",
     "T\\.prim_func",
     "nki\\.jit"
    ],
    "message": "a kernel definition",
    "level": "suspicious"
   }
  ],
  "allowed_torch_calls": [
   "torch.empty",
   "torch.cuda.current_stream"
  ],
  "mutation": {
   "inputs_mutated": [],
   "restore_required": false
  },
