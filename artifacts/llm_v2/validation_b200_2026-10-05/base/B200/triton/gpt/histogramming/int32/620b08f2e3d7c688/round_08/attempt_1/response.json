vice, dtype=torch.int32)\n\n    _count_partials[(P,)](\n        input,\n        partials,\n        N=N,\n        NUM_BINS=num_bins,\n        P=P,\n        CHUNK_SIZE=4096,\n        num_warps=16,\n        num_stages=1,\n    )\n    _reduce_partials[(triton.cdiv(num_bins, 16),)](\n        partials,\n        output,\n        P=P,\n        NUM_BINS=num_bins,\n        ROW_BLOCK=1024,\n        BIN_BLOCK=16,\n        num_warps=8,\n        num_stages=1,\n    )\n    return output\n\n\ndef get_last_config() -> dict:\n    return {\n        \"partial_cap\": 592,\n        \"chunk_size\": 4096,\n        \"count_num_warps\": 16,\n        \"count_num_stages\": 1,\n        \"count_loop_stages\": 3,\n        \"count_method\": \"private_global_atomic_add\",\n        \"input_cache_modifier\": \".cg\",\n        \"input_eviction_policy\": \"evict_first\",\n        \"atomic_semantics\": \"relaxed\",\n        \"atomic_scope\": \"cta\",\n        \"reduce_row_block\": 1024,\n        \"reduce_bin_block\": 16,\n        \"reduce_num_warps\": 8,\n        \"reduce_num_stages\": 1,\n        \"reduce_method\": \"single_tile_tree_sum\",\n        \"reduce_cache_modifier\": \".cg\",\n        \"scratch_initialization\": \"owning_program\",\n    }\n```",
