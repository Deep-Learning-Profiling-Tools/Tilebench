       "parsed": null,
       "text": "```python title=\"impl_cutile.py\"\nimport torch\nimport cuda.tile as ct\n\n\n@ct.kernel(num_ctas=1, occupancy=8)\ndef _count_private(\n    input,\n    partials,\n    N: ct.Constant[int],\n    P: ct.Constant[int],\n    CHUNK: ct.Constant[int],\n):\n    pid = ct.bid(0)\n\n    for chunk_id in range(pid, N // CHUNK, P):\n        values = ct.load(\n            input,\n            (chunk_id,),\n            (CHUNK,),\n            allow_tma=False,\n        )\n        ct.atomic_add(\n            partials,\n            (pid, values),\n            1,\n            check_bounds=True,\n            memory_order=ct.MemoryOrder.RELAXED,\n            memory_scope=ct.MemoryScope.BLOCK,\n        )\n\n\n@ct.kernel(num_ctas=1, occupancy=4)\ndef _reduce_private(\n    partials,\n    output,\n    P: ct.Constant[int],\n    ROWS: ct.Constant[int],\n    BINS: ct.Constant[int],\n):\n    bin_tile = ct.bid(0)\n    counts = ct.zeros((BINS,), ct.int32)\n\n    for row_tile in range(ct.cdiv(P, ROWS)):\n        values = ct.load(\n            partials,\n            (row_tile, bin_tile),\n            (ROWS, BINS),\n            padding_mode=ct.PaddingMode.ZERO,\n            allow_tma=False,\n        )\n        counts = counts + ct.sum(values, axis=0)\n\n    ct.store(output, (bin_tile,), counts, allow_tma=False)\n\n\ndef run(input: torch.Tensor, N: int, num_bins: int, **kwargs):\n    assert input.is_cuda\n    assert input.dtype == torch.int32\n    assert len(input.shape) == 1\n    assert input.shape[0] == N\n    assert input.stride() == (1,)\n    assert N == 67108864\n    assert num_bins == 4096\n\n    partial_cap = 2048\n    chunk = 4096\n    reduce_rows = 512\n    reduce_bins = 8\n    P = min(partial_cap, ct.cdiv(N, chunk))\n\n    output = torch.empty((num_bins,), dtype=torch.int32, device=input.device)\n    partials = torch.zeros(\n        (P, num_bins), dtype=torch.int32, device=input.device\n    )\n    stream = torch.cuda.current_stream()\n\n    ct.launch(\n        stream,\n        (P,),\n        _count_private,\n        (input, partials, N, P, chunk),\n    )\n    ct.launch(\n        stream,\n        (ct.cdiv(num_bins, reduce_bins),),\n        _reduce_private,\n        (partials, output, P, reduce_rows, reduce_bins),\n    )\n    return output\n\n\ndef get_last_config() -> dict:\n    return {\n        \"partial_cap\": 2048,\n        \"count_chunk\": 4096,\n        \"count_num_ctas\": 1,\n        \"count_occupancy\": 8,\n        \"atomic_order\": \"relaxed\",\n        \"atomic_scope\": \"block\",\n        \"scratch_initialization\": \"torch.zeros\",\n        \"reduce_rows\": 512,\n        \"reduce_bins\": 8,\n        \"reduce_num_ctas\": 1,\n        \"reduce_occupancy\": 4,\n        \"allow_tma\": False,\n    }\n```",
